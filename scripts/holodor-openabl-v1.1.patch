  */
 
 /**
-  Input - maps firmware key events to UI inputs.
+  Input - maps firmware key events, PMIC buttons, and UART gamepads to UI
+  inputs.
 */
 
 #include "Efi/Input.h"
 
+#include "Base/Memory.h"
+#include "Base/Text.h"
 #include "Efi/Efi.h"
+#include "Efi/Qcom.h"
+
+// EFI_QCOM_PMIC_PWRON_PROTOCOL_GUID (ButtonsDxe 0x80f8):
+// offset 24 is GetPonRtStatus (PmicDeviceIndex, PonIrqType, &RtStatus),
+// where PonIrqType 0 = KPDPWR_ON (Power), 1 = RESIN_ON (Volume Down).
+STATIC EFI_GUID mPmicPwronGuid = {
+  0x9ba45b66,
+  0xefa4,
+  0x441c,
+  {0xa3, 0xe4, 0xed, 0x22, 0x24, 0x78, 0x6b, 0xe2}};
+
+typedef struct _PMIC_PWRON_PROTOCOL {
+  UINT64 Revision;
+  VOID  *GetPonPblStatus;
+  VOID  *SetPonTrigger;
+  EFI_STATUS (EFIAPI *GetPonRtStatus) (
+    IN UINT32    PmicDeviceIndex,
+    IN UINT32    PonIrqType,
+    OUT BOOLEAN *Status
+  );
+} PMIC_PWRON_PROTOCOL;
+
+// EFI_QCOM_PMIC_GPIO_PROTOCOL_GUID (ButtonsDxe 0x80e8):
+// offset 56 is IrqStatus (PmicDeviceIndex, GpioIndex, IrqStatusType, &Status),
+// where GpioIndex 5 = GPIO 6 (Volume Up, active-low: Status == 0 when pressed).
+STATIC EFI_GUID mPmicGpioGuid = {
+  0x4bc5c6d7,
+  0x4ca4,
+  0x8835,
+  {0xd1, 0xbc, 0xd2, 0x9c, 0xc2, 0x02, 0x5d, 0x4a}};
+
+typedef struct _PMIC_GPIO_PROTOCOL {
+  UINT64 Revision;
+  VOID  *ConfigDigitalInput;
+  VOID  *ConfigDigitalOutput;
+  VOID  *GetStatus;
+  VOID  *IrqEnable;
+  VOID  *IrqClear;
+  VOID  *IrqSetTrigger;
+  EFI_STATUS (EFIAPI *IrqStatus) (
+    IN UINT32    PmicDeviceIndex,
+    IN UINT32    GpioIndex,
+    IN UINT32    Type,
+    OUT BOOLEAN *Status
+  );
+} PMIC_GPIO_PROTOCOL;
+
+// EFI_TLMM_PROTOCOL_GUID: used to configure TLMM UART pins and MCU enable/reset
+// GPIOs for handheld UART gamepads.
+STATIC EFI_GUID mTlmmGuid = {
+  0x1ef8402d,
+  0x03b4,
+  0x409f,
+  {0xba, 0x62, 0x11, 0x52, 0x93, 0x23, 0x56, 0x1f}};
+
+typedef struct _TLMM_PROTOCOL {
+  EFI_STATUS (EFIAPI *ConfigGpio) (IN UINT32 Config, IN UINT32 Enable);
+  VOID *ConfigGpioGroup;
+  EFI_STATUS (EFIAPI *GpioIn) (IN UINT32 Config, OUT UINT32 *Value);
+  EFI_STATUS (EFIAPI *GpioOut) (IN UINT32 Config, IN UINT32 Value);
+} TLMM_PROTOCOL;
+
+#define TLMM_GPIO_ENABLE   1U
+#define TLMM_GPIO_INPUT    0U
+#define TLMM_GPIO_OUTPUT   1U
+#define TLMM_GPIO_NO_PULL  0U
+#define TLMM_GPIO_PULL_UP  3U
+#define TLMM_GPIO_2MA      0U
+#define TLMM_GPIO_LOW      0U
+#define TLMM_GPIO_HIGH     1U
+#define PAD_NONE_GPIO      0xFFFFU
+
+STATIC UINT32
+TlmmCfg (
+  IN UINT16 Gpio,
+  IN UINT8  Func,
+  IN UINT8  Dir,
+  IN UINT8  Pull,
+  IN UINT8  Drv
+)
+{
+  return ((UINT32)(Func & 0xFU)) | (((UINT32)(Gpio & 0x3FFU)) << 4) |
+         (((UINT32)(Dir & 0x1U)) << 14) | (((UINT32)(Pull & 0x3U)) << 15) |
+         (((UINT32)(Drv & 0x7U)) << 17);
+}
+
+STATIC BOOLEAN              mHwInit;
+STATIC PMIC_PWRON_PROTOCOL *mPwron;
+STATIC PMIC_GPIO_PROTOCOL  *mPmicGpio;
+STATIC TLMM_PROTOCOL       *mTlmm;
+STATIC UINT32               mVolUpPmic;
+STATIC BOOLEAN              mHasVolUpGpio;
+
+STATIC VOID *
+OpenFirst (IN EFI_GUID *Guid)
+{
+  EFI_HANDLE *Handles   = NULL;
+  UINTN       Count     = LocateHandles (Guid, &Handles);
+  VOID       *Interface = Count ? GetProtocol (Handles[0], Guid) : NULL;
+
+  if (Handles) {
+    gBS->FreePool (Handles);
+  }
+  return Interface;
+}
+
+STATIC VOID
+InitHwButtons (VOID)
+{
+  EFI_PM_DEVICE_INFO_TYPE Pmics[QCOM_PMICS_MAX];
+  UINTN                   Count;
+
+  if (mHwInit) {
+    return;
+  }
+  mHwInit   = TRUE;
+  mPwron    = OpenFirst (&mPmicPwronGuid);
+  mPmicGpio = OpenFirst (&mPmicGpioGuid);
+  mTlmm     = OpenFirst (&mTlmmGuid);
+  Count     = QcomPmics (Pmics);
+  if (Count > 0 && Pmics[0].PmicModel == EFI_PMIC_IS_PM8150) {
+    mVolUpPmic    = 0;
+    mHasVolUpGpio = TRUE;
+  } else if (Count > 1) {
+    mVolUpPmic    = 1;
+    mHasVolUpGpio = TRUE;
+  }
+}
+
+// Polls the physical buttons directly through PmicDxe:
+// Held[0] = INPUT_UP (Volume Up, PMIC GPIO 6 active-low)
+// Held[1] = INPUT_DOWN (Volume Down, PON RESIN_N)
+// Held[2] = INPUT_SELECT (Power, PON KPDPWR_N)
+STATIC VOID
+PollHwButtons (OUT BOOLEAN Held[3])
+{
+  BOOLEAN Status = FALSE;
+
+  InitHwButtons ();
+  Held[0] = FALSE;
+  Held[1] = FALSE;
+  Held[2] = FALSE;
+
+  if (mPmicGpio && mHasVolUpGpio) {
+    Status = TRUE;
+    if (mPmicGpio->IrqStatus (mVolUpPmic, 5, 0, &Status) == EFI_SUCCESS &&
+        Status == 0) {
+      Held[0] = TRUE;
+    }
+  }
+  if (mPwron) {
+    Status = FALSE;
+    if (mPwron->GetPonRtStatus (0, 1, &Status) == EFI_SUCCESS && Status != 0) {
+      Held[1] = TRUE;
+    }
+    Status = FALSE;
+    if (mPwron->GetPonRtStatus (0, 0, &Status) == EFI_SUCCESS && Status != 0) {
+      Held[2] = TRUE;
+    }
+  }
+}
+
+BOOLEAN
+InputVolumeDownHeld (VOID)
+{
+  BOOLEAN Held[3];
+
+  PollHwButtons (Held);
+  return Held[1];
+}
+
+// Handheld UART Gamepad (SM8250 Retroid / SM8550 & SM8750 Moorechip rsinput)
+
+typedef struct _PAD_BOARD {
+  UINT64  UartBase;
+  UINT64  VoteReg;
+  UINT32  VoteBits;
+  UINT64  RcgBase;
+  UINT16  TxGpio;
+  UINT16  RxGpio;
+  UINT8   UartFunc;
+  UINT16  VddGpio;
+  UINT16  BootGpio;
+  UINT16  EnGpio;
+  UINT16  RstGpio;
+  BOOLEAN IsRetroid8250;
+} PAD_BOARD;
+
+STATIC inline UINT32
+RegRead32 (IN UINT64 Addr)
+{
+  return *(volatile CONST UINT32 *)(UINTN)Addr;
+}
+
+STATIC inline VOID
+RegWrite32 (
+  IN UINT64 Addr,
+  IN UINT32 Val
+)
+{
+  *(volatile UINT32 *)(UINTN)Addr = Val;
+}
+
+STATIC VOID
+PadGpioOut (
+  IN UINT16 Gpio,
+  IN UINT32 Value
+)
+{
+  UINT32 Cfg;
+
+  if (!mTlmm || Gpio == PAD_NONE_GPIO) {
+    return;
+  }
+  Cfg = TlmmCfg (Gpio, 0, TLMM_GPIO_OUTPUT, TLMM_GPIO_NO_PULL, TLMM_GPIO_2MA);
+  (VOID)mTlmm->ConfigGpio (Cfg, TLMM_GPIO_ENABLE);
+  (VOID)mTlmm->GpioOut (Cfg, Value);
+}
+
+STATIC BOOLEAN
+GamepadBoardOf (OUT PAD_BOARD *Out)
+{
+  QCOM_CHIP Chip;
+  UINT32    Id;
+  OABL_TEXT Name;
+
+  if (!QcomChip (&Chip)) {
+    return FALSE;
+  }
+  Id   = EFI_ERROR (Chip.Id.Status) ? 0 : Chip.Id.Value;
+  Name = TextTrim (TextOf (Chip.Name));
+
+  // SM8250: Retroid Pocket 5 / Flip 2 / Mini (uart16 @ 0x00888000, QUP2 SE2)
+  if (Id == 356 || TextStartsWith (Name, "SM8250")) {
+    *Out = (PAD_BOARD){
+      .UartBase      = 0x00888000ULL,
+      .VoteReg       = 0x00152010ULL,
+      .VoteBits      = 0x0000004FU,
+      .RcgBase       = 0x0011E270ULL,
+      .TxGpio        = 50,
+      .RxGpio        = 51,
+      .UartFunc      = 1,
+      .VddGpio       = 3,
+      .BootGpio      = 110,
+      .EnGpio        = 111,
+      .RstGpio       = 109,
+      .IsRetroid8250 = TRUE,
+    };
+    return TRUE;
+  }
+
+  // SM8550 / QCS8550 / SG3x Gen 2: RP6 / RP Nova / Odin 2 family
+  // (uart15 @ 0x0089C000, QUP2 SE7)
+  if (Id == 601 || Id == 603 || Id == 519 || Id == 536 ||
+      TextStartsWith (Name, "SM8550") || TextStartsWith (Name, "QCS8550")) {
+    *Out = (PAD_BOARD){
+      .UartBase      = 0x0089C000ULL,
+      .VoteReg       = 0x00152010ULL,
+      .VoteBits      = 0x0002000FU,
+      .RcgBase       = 0x0011E898ULL,
+      .TxGpio        = 74,
+      .RxGpio        = 75,
+      .UartFunc      = 2,
+      .VddGpio       = 99,
+      .BootGpio      = PAD_NONE_GPIO,
+      .EnGpio        = 12,
+      .RstGpio       = PAD_NONE_GPIO,
+      .IsRetroid8250 = FALSE,
+    };
+    return TRUE;
+  }
+
+  // SM8750 / CQ8725S: Odin 3 family (uart15 @ 0x0089C000, QUP2 SE7)
+  if (Id == 639 || Id == 706 || Id == 618 ||
+      TextStartsWith (Name, "SM8750") || TextStartsWith (Name, "CQ8725S")) {
+    *Out = (PAD_BOARD){
+      .UartBase      = 0x0089C000ULL,
+      .VoteReg       = 0x00152010ULL,
+      .VoteBits      = 0x0002000FU,
+      .RcgBase       = 0x0011E8B8ULL,
+      .TxGpio        = 30,
+      .RxGpio        = 31,
+      .UartFunc      = 1,
+      .VddGpio       = 83,
+      .BootGpio      = PAD_NONE_GPIO,
+      .EnGpio        = 85,
+      .RstGpio       = PAD_NONE_GPIO,
+      .IsRetroid8250 = FALSE,
+    };
+    return TRUE;
+  }
+
+  return FALSE;
+}
+
+STATIC VOID
+GeniUartStop (IN UINT64 UartBase)
+{
+  UINT32 FifoWords;
+
+  if (!UartBase) {
+    return;
+  }
+  RegWrite32 (UartBase + 0x614, 0);
+  RegWrite32 (UartBase + 0x644, 0);
+  if (RegRead32 (UartBase + 0x040) & 0x1000U) {
+    RegWrite32 (UartBase + 0x634, 0x4U);
+    gBS->Stall (200);
+    if (RegRead32 (UartBase + 0x040) & 0x1000U) {
+      RegWrite32 (UartBase + 0x634, 0x2U);
+      gBS->Stall (200);
+    }
+  }
+  if (RegRead32 (UartBase + 0x040) & 0x1U) {
+    RegWrite32 (UartBase + 0x604, 0x4U);
+    gBS->Stall (200);
+    if (RegRead32 (UartBase + 0x040) & 0x1U) {
+      RegWrite32 (UartBase + 0x604, 0x2U);
+      gBS->Stall (200);
+    }
+  }
+  FifoWords = RegRead32 (UartBase + 0x804) & 0x3FU;
+  while (FifoWords--) {
+    (VOID)RegRead32 (UartBase + 0x780);
+  }
+  RegWrite32 (UartBase + 0x618, 0xFFFFFFFFU);
+  RegWrite32 (UartBase + 0x648, 0xFFFFFFFFU);
+}
+
+STATIC BOOLEAN
+GeniUartInit (IN CONST PAD_BOARD *Board)
+{
+  UINT64 Uart = Board->UartBase;
+  UINT32 FwRev;
+
+  if (!mTlmm) {
+    return FALSE;
+  }
+
+  // Enable QUPv3 wrapper + serial engine branch clocks in GCC.
+  RegWrite32 (Board->VoteReg, RegRead32 (Board->VoteReg) | Board->VoteBits);
+  gBS->Stall (100);
+
+  // Configure RCG for 7,372,800 Hz (115200 * 64) from GPLL0_OUT_EVEN (300 MHz).
+  RegWrite32 (Board->RcgBase + 0x04, 0x00002601U);
+  RegWrite32 (Board->RcgBase + 0x08, 0x00000180U);
+  RegWrite32 (Board->RcgBase + 0x0C, 0x0000C476U);
+  RegWrite32 (Board->RcgBase + 0x10, 0x0000C2F6U);
+  RegWrite32 (Board->RcgBase + 0x00, RegRead32 (Board->RcgBase + 0x00) | 0x1U);
+  for (UINTN Spin = 0; Spin < 100; Spin++) {
+    if ((RegRead32 (Board->RcgBase + 0x00) & 0x1U) == 0) {
+      break;
+    }
+    gBS->Stall (10);
+  }
+
+  // Verify TZ loaded GENI_SE_UART (protocol 2) into this serial engine.
+  FwRev = RegRead32 (Uart + 0x068);
+  if (((FwRev >> 8) & 0xFFU) != 2U) {
+    return FALSE;
+  }
+
+  // Route TX and RX pins to the QUPv3 serial engine in TLMM.
+  (VOID)mTlmm->ConfigGpio (
+    TlmmCfg (
+      Board->TxGpio, Board->UartFunc, TLMM_GPIO_OUTPUT, TLMM_GPIO_PULL_UP,
+      TLMM_GPIO_2MA
+    ),
+    TLMM_GPIO_ENABLE
+  );
+  (VOID)mTlmm->ConfigGpio (
+    TlmmCfg (
+      Board->RxGpio, Board->UartFunc, TLMM_GPIO_INPUT, TLMM_GPIO_PULL_UP,
+      TLMM_GPIO_2MA
+    ),
+    TLMM_GPIO_ENABLE
+  );
+
+  GeniUartStop (Uart);
+
+  // Configure FIFO mode, 4x8-bit byte packing, and 115200 8N1 (div=4, 16x).
+  RegWrite32 (Uart + 0x000, 0x0U);
+  RegWrite32 (Uart + 0x028, RegRead32 (Uart + 0x028) | 0x7FU);
+  RegWrite32 (Uart + 0x020, 0x1U);
+  RegWrite32 (Uart + 0x024, 0x7FU);
+  RegWrite32 (Uart + 0x258, 0x0U);
+  RegWrite32 (Uart + 0xE18, 0x0U);
+  RegWrite32 (Uart + 0x260, 0x0004380EU);
+  RegWrite32 (Uart + 0x264, 0x000C3E0EU);
+  RegWrite32 (Uart + 0x284, 0x0004380EU);
+  RegWrite32 (Uart + 0x288, 0x000C3E0EU);
+  RegWrite32 (Uart + 0x07C, 0x0U);
+  RegWrite32 (Uart + 0x048, 0x41U);
+  RegWrite32 (Uart + 0x04C, 0x41U);
+  RegWrite32 (Uart + 0x25C, 0x2U);
+  RegWrite32 (Uart + 0x268, 0x8U);
+  RegWrite32 (Uart + 0x26C, 0x0U);
+  RegWrite32 (Uart + 0x280, 0x0U);
+  RegWrite32 (Uart + 0x28C, 0x8U);
+  RegWrite32 (Uart + 0x294, 0xA0U);
+  RegWrite32 (Uart + 0x2A4, 0x0U);
+  RegWrite32 (Uart + 0x2A8, 0x0U);
+  RegWrite32 (Uart + 0x618, 0xFFFFFFFFU);
+  RegWrite32 (Uart + 0x648, 0xFFFFFFFFU);
+
+  // Start secondary engine RX (UART_START_READ = 1 << 27).
+  RegWrite32 (Uart + 0x630, 0x08000000U);
+  return TRUE;
+}
+
+STATIC VOID
+GeniUartTx (
+  IN UINT64       Uart,
+  IN CONST UINT8 *Data,
+  IN UINTN        Len
+)
+{
+  if (!Uart || !Len) {
+    return;
+  }
+  RegWrite32 (Uart + 0x618, 0xFFFFFFFFU);
+  RegWrite32 (Uart + 0x270, (UINT32)Len);
+  RegWrite32 (Uart + 0x600, 0x08000000U);
+  for (UINTN Index = 0; Index < Len; Index += 4) {
+    UINT32 Word  = 0;
+    UINTN  Chunk = (Len - Index >= 4) ? 4 : (Len - Index);
+    for (UINTN Byte = 0; Byte < Chunk; Byte++) {
+      Word |= ((UINT32)Data[Index + Byte]) << (8 * Byte);
+    }
+    RegWrite32 (Uart + 0x700, Word);
+  }
+  for (UINTN Spin = 0; Spin < 100; Spin++) {
+    if (RegRead32 (Uart + 0x610) & 0x1U) {
+      break;
+    }
+    gBS->Stall (100);
+  }
+  RegWrite32 (Uart + 0x618, 0xFFFFFFFFU);
+}
+
+STATIC VOID
+PadSendCmd (
+  IN OUT INPUT_KEYS *Keys,
+  IN UINT8           Cmd,
+  IN CONST UINT8    *Payload,
+  IN UINTN           PayloadLen
+)
+{
+  UINT8 Frame[32];
+  UINT8 Checksum = 0;
+  UINTN Len      = 0;
+
+  if (PayloadLen > sizeof (Frame) - 9) {
+    return;
+  }
+  Frame[Len++] = 0xA5;
+  Frame[Len++] = 0xD3;
+  Frame[Len++] = 0x5A;
+  Frame[Len++] = 0x3D;
+  Frame[Len++] = Keys->PadSeq++;
+  Frame[Len++] = Cmd;
+  Frame[Len++] = (UINT8)(PayloadLen & 0xFFU);
+  Frame[Len++] = (UINT8)((PayloadLen >> 8) & 0xFFU);
+  for (UINTN Index = 0; Index < PayloadLen; Index++) {
+    Frame[Len++] = Payload[Index];
+  }
+  for (UINTN Index = 4; Index < Len; Index++) {
+    Checksum ^= Frame[Index];
+  }
+  Frame[Len++] = Checksum;
+  GeniUartTx (Keys->PadUartBase, Frame, Len);
+}
+
+STATIC VOID
+GeniUartDrainRx (IN OUT INPUT_KEYS *Keys)
+{
+  UINT64 Uart       = Keys->PadUartBase;
+  UINT32 SStatus;
+  UINT32 FifoStatus;
+  UINT32 WordCnt;
+
+  if (!Uart) {
+    return;
+  }
+  SStatus    = RegRead32 (Uart + 0x640);
+  FifoStatus = RegRead32 (Uart + 0x804);
+  WordCnt    = FifoStatus & 0x01FFFFFFU;
+  if (WordCnt > 0) {
+    BOOLEAN LastPartial = (FifoStatus & 0x80000000U) != 0;
+    UINT32  LastBytes   = (FifoStatus >> 28) & 0x7U;
+    UINT32  TotalBytes  = 4U * (WordCnt - 1);
+
+    if (LastPartial && LastBytes) {
+      TotalBytes += LastBytes;
+    } else {
+      TotalBytes += 4U;
+    }
+    for (UINT32 WordIdx = 0; WordIdx < WordCnt; WordIdx++) {
+      UINT32 Word  = RegRead32 (Uart + 0x780);
+      UINT32 Chunk = (TotalBytes >= 4U) ? 4U : TotalBytes;
+      TotalBytes  -= Chunk;
+      for (UINT32 Byte = 0; Byte < Chunk; Byte++) {
+        UINT8 Val = (UINT8)((Word >> (8 * Byte)) & 0xFFU);
+        if (Keys->PadRxLen >= sizeof (Keys->PadRxBuf)) {
+          CopyMem (
+            Keys->PadRxBuf, Keys->PadRxBuf + 1, sizeof (Keys->PadRxBuf) - 1
+          );
+          Keys->PadRxLen = sizeof (Keys->PadRxBuf) - 1;
+        }
+        Keys->PadRxBuf[Keys->PadRxLen++] = Val;
+      }
+    }
+  }
+  if (SStatus) {
+    RegWrite32 (Uart + 0x648, SStatus);
+  }
+}
+
+STATIC VOID
+PadDropRxBytes (
+  IN OUT INPUT_KEYS *Keys,
+  IN UINTN           Count
+)
+{
+  if (Count >= Keys->PadRxLen) {
+    Keys->PadRxLen = 0;
+    return;
+  }
+  CopyMem (Keys->PadRxBuf, Keys->PadRxBuf + Count, Keys->PadRxLen - Count);
+  Keys->PadRxLen -= Count;
+}
+
+STATIC VOID
+PadUpdateStatus (
+  IN OUT INPUT_KEYS *Keys,
+  IN CONST UINT8    *Frame,
+  IN UINT16          PayloadLen
+)
+{
+  UINT16 Btn;
+  INT16  Ly    = 0;
+  INT16  Ry    = 0;
+  INT16  BestY = 0;
+
+  if (PayloadLen < 6) {
+    return;
+  }
+  Btn = (UINT16)Frame[8] | ((UINT16)Frame[9] << 8);
+  if (PayloadLen >= 14) {
+    Ly    = -(INT16)((UINT16)Frame[16] | ((UINT16)Frame[17] << 8));
+    Ry    = -(INT16)((UINT16)Frame[20] | ((UINT16)Frame[21] << 8));
+    BestY = (Ly < -250 || Ly > 250) ? Ly : Ry;
+  }
+
+  if (Keys->PadStickUp) {
+    if (BestY > -250) {
+      Keys->PadStickUp = FALSE;
+    }
+  } else if (BestY < -450) {
+    Keys->PadStickUp = TRUE;
+  }
+
+  if (Keys->PadStickDown) {
+    if (BestY < 250) {
+      Keys->PadStickDown = FALSE;
+    }
+  } else if (BestY > 450) {
+    Keys->PadStickDown = TRUE;
+  }
+
+  // PadHeldAtStart is unused here; store current held state in PadHeldAtStart
+  // slots as live state for PollGamepad:
+  // [0] = INPUT_UP     (D-Pad Up BIT(0) or Analog Stick Up)
+  // [1] = INPUT_DOWN   (D-Pad Down BIT(1) or Analog Stick Down)
+  // [2] = INPUT_SELECT (BTN_SOUTH BIT(7), BTN_EAST BIT(6), BTN_START BIT(11),
+  //                     or D-Pad Right BIT(3))
+  // [3] = INPUT_BACK   (BTN_WEST BIT(5), BTN_NORTH BIT(4), BTN_SELECT BIT(10),
+  //                     BTN_TL BIT(8), or D-Pad Left BIT(2))
+  Keys->PadHeldAtStart[0] = ((Btn & (1U << 0)) != 0) || Keys->PadStickUp;
+  Keys->PadHeldAtStart[1] = ((Btn & (1U << 1)) != 0) || Keys->PadStickDown;
+  Keys->PadHeldAtStart[2] =
+    (Btn & ((1U << 7) | (1U << 6) | (1U << 11) | (1U << 3))) != 0;
+  Keys->PadHeldAtStart[3] =
+    (Btn & ((1U << 5) | (1U << 4) | (1U << 10) | (1U << 8) | (1U << 2))) != 0;
+}
+
+STATIC VOID
+GamepadParseRx (
+  IN OUT INPUT_KEYS *Keys,
+  OUT BOOLEAN       *SawVersion
+)
+{
+  *SawVersion = FALSE;
+  while (Keys->PadRxLen >= 9) {
+    UINT16 PayloadLen;
+    UINTN  FrameLen;
+    UINT8  Checksum = 0;
+
+    if (Keys->PadRxBuf[0] != 0xA5 || Keys->PadRxBuf[1] != 0xD3 ||
+        Keys->PadRxBuf[2] != 0x5A || Keys->PadRxBuf[3] != 0x3D) {
+      PadDropRxBytes (Keys, 1);
+      continue;
+    }
+    PayloadLen = (UINT16)Keys->PadRxBuf[6] | ((UINT16)Keys->PadRxBuf[7] << 8);
+    if (PayloadLen > 64) {
+      PadDropRxBytes (Keys, 4);
+      continue;
+    }
+    FrameLen = 9U + PayloadLen;
+    if (Keys->PadRxLen < FrameLen) {
+      break;
+    }
+    for (UINTN Index = 4; Index < FrameLen - 1; Index++) {
+      Checksum ^= Keys->PadRxBuf[Index];
+    }
+    if (Checksum != Keys->PadRxBuf[FrameLen - 1]) {
+      PadDropRxBytes (Keys, 4);
+      continue;
+    }
+    if (Keys->PadRxBuf[5] == 0x01 && PayloadLen >= 1 &&
+        Keys->PadRxBuf[8] == 0x02) {
+      *SawVersion = TRUE;
+    } else if (Keys->PadRxBuf[5] == 0x02) {
+      Keys->PadActive = TRUE;
+      PadUpdateStatus (Keys, Keys->PadRxBuf, PayloadLen);
+    }
+    PadDropRxBytes (Keys, FrameLen);
+  }
+}
+
+STATIC VOID
+PollGamepad (
+  IN OUT INPUT_KEYS *Keys,
+  IN UINT64          Now,
+  OUT BOOLEAN        Held[4]
+)
+{
+  STATIC CONST UINT8 Cmd0701[]  = {0x07, 0x01};
+  STATIC CONST UINT8 Cmd06[]    = {0x06};
+  STATIC CONST UINT8 CmdVer[]   = {0x02};
+  STATIC CONST UINT8 CmdPar[]   = {0x05, 0x01, 0x00, 0x00, 0x00,
+                                   0x28, 0x00, 0x00, 0x00, 0x07};
+  BOOLEAN            SawVersion = FALSE;
+
+  for (UINTN Index = 0; Index < 4; Index++) {
+    Held[Index] = FALSE;
+  }
+
+  if (!Keys->PadInitDone) {
+    PAD_BOARD Board;
+
+    InitHwButtons ();
+    Keys->PadInitDone = TRUE;
+    if (!GamepadBoardOf (&Board) || !GeniUartInit (&Board)) {
+      Keys->PadStep = 99;
+      return;
+    }
+    Keys->PadUartBase      = Board.UartBase;
+    Keys->PadEnGpio        = Board.EnGpio;
+    Keys->PadRstGpio       = Board.RstGpio;
+    Keys->PadIsRetroid8250 = Board.IsRetroid8250;
+    PadGpioOut (Board.VddGpio, TLMM_GPIO_HIGH);
+    PadGpioOut (Board.BootGpio, TLMM_GPIO_LOW);
+    PadGpioOut (Board.EnGpio, TLMM_GPIO_LOW);
+    PadGpioOut (Board.RstGpio, TLMM_GPIO_LOW);
+    Keys->PadStep   = 1;
+    Keys->PadNextMs = Now + 80;
+    return;
+  }
+
+  if (Keys->PadStep == 99 || !Keys->PadUartBase) {
+    return;
+  }
+
+  GeniUartDrainRx (Keys);
+  GamepadParseRx (Keys, &SawVersion);
+
+  switch (Keys->PadStep) {
+  case 1:
+    if (Now >= Keys->PadNextMs) {
+      PadGpioOut (Keys->PadEnGpio, TLMM_GPIO_HIGH);
+      PadGpioOut (Keys->PadRstGpio, TLMM_GPIO_HIGH);
+      Keys->PadRxLen  = 0;
+      Keys->PadStep   = Keys->PadIsRetroid8250 ? 10 : 2;
+      Keys->PadNextMs = Now + (Keys->PadIsRetroid8250 ? 100 : 60);
+    }
+    break;
+  case 2:
+    if (Now >= Keys->PadNextMs) {
+      Keys->PadRxLen = 0;
+      PadSendCmd (Keys, 0x01, CmdVer, sizeof (CmdVer));
+      Keys->PadStep   = 3;
+      Keys->PadNextMs = Now + 400;
+    }
+    break;
+  case 3:
+    if (SawVersion || Keys->PadActive) {
+      PadSendCmd (Keys, 0x01, CmdPar, sizeof (CmdPar));
+      Keys->PadActive = TRUE;
+      Keys->PadStep   = 20;
+    } else if (Now >= Keys->PadNextMs) {
+      if (++Keys->PadAttempts < 3) {
+        PadGpioOut (Keys->PadEnGpio, TLMM_GPIO_LOW);
+        PadGpioOut (Keys->PadRstGpio, TLMM_GPIO_LOW);
+        Keys->PadStep   = 1;
+        Keys->PadNextMs = Now + 80;
+      } else {
+        Keys->PadStep = 99;
+      }
+    }
+    break;
+  case 10:
+    if (Now >= Keys->PadNextMs) {
+      PadSendCmd (Keys, 0x01, Cmd0701, sizeof (Cmd0701));
+      Keys->PadStep   = 11;
+      Keys->PadNextMs = Now + 100;
+    }
+    break;
+  case 11:
+    if (Now >= Keys->PadNextMs) {
+      PadSendCmd (Keys, 0x01, Cmd06, sizeof (Cmd06));
+      Keys->PadStep   = 12;
+      Keys->PadNextMs = Now + 100;
+    }
+    break;
+  case 12:
+    if (Now >= Keys->PadNextMs) {
+      PadSendCmd (Keys, 0x01, CmdVer, sizeof (CmdVer));
+      Keys->PadStep   = 13;
+      Keys->PadNextMs = Now + 100;
+    }
+    break;
+  case 13:
+    if (Now >= Keys->PadNextMs) {
+      PadSendCmd (Keys, 0x01, CmdPar, sizeof (CmdPar));
+      Keys->PadStep   = 14;
+      Keys->PadNextMs = Now + 100;
+    }
+    break;
+  case 14:
+    if (Now >= Keys->PadNextMs) {
+      PadSendCmd (Keys, 0x01, Cmd06, sizeof (Cmd06));
+      Keys->PadStep   = 15;
+      Keys->PadNextMs = Now + 100;
+    }
+    break;
+  case 15:
+    if (Now >= Keys->PadNextMs) {
+      PadSendCmd (Keys, 0x01, CmdVer, sizeof (CmdVer));
+      Keys->PadActive = TRUE;
+      Keys->PadStep   = 20;
+    }
+    break;
+  case 20:
+  default:
+    break;
+  }
+
+  if (Keys->PadActive) {
+    for (UINTN Index = 0; Index < 4; Index++) {
+      Held[Index] = Keys->PadHeldAtStart[Index];
+    }
+  }
+}
+
+VOID
+InputKeysClose (IN OUT INPUT_KEYS *Keys)
+{
+  if (!Keys->PadInitDone || !Keys->PadUartBase) {
+    return;
+  }
+  PadGpioOut (Keys->PadEnGpio, TLMM_GPIO_LOW);
+  PadGpioOut (Keys->PadRstGpio, TLMM_GPIO_LOW);
+  gBS->Stall (1000);
+  GeniUartStop (Keys->PadUartBase);
+  Keys->PadActive   = FALSE;
+  Keys->PadUartBase = 0;
+  Keys->PadStep     = 99;
+}
 
