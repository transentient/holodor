# pocknix-bsp-sm8550 — board support for the SM8550 FAMILY: Retroid Pocket Nova,
# Retroid Pocket 6 (+TOP-DPAD), AYN Odin 2 / Mini / Portal.
pkgname=holodor-bsp-sm8550
pkgver=0.2.0
pkgrel=5
pkgdesc="pocknix board support: SM8550 family (RP Nova, RP6, Odin 2 family) — runtime board dispatch, input map, suspend quirks, audio UCM & topology"
arch=('any')
url="https://github.com/transentient/holodor"
license=('GPL2')
depends=('holodor-bsp-common' 'libpulse')
install=pocknix-bsp-sm8550.install
options=('!strip' '!debug')
provides=('holodor-bsp' 'pocknix-bsp' 'pocknix-bsp-sm8550')
conflicts=('holodor-bsp' 'pocknix-bsp' 'pocknix-bsp-sm8550')
replaces=('pocknix-bsp-sm8550' 'pocknix-bsp' 'pocknix-bsp-rp6' 'pocknix-bsp-odin2' 'pocknix-bsp-odin2mini' 'pocknix-bsp-odin2portal')
optdepends=('inputplumber: gamepad -> Steam Input mapping (01-rsinput-controller.yaml)'
            'alsa-ucm-conf: base UCM (codec include sequences for the AYN-Odin2 / SM8550-RetroidPocket-I2S UCM)')
source=('device.conf'
        '01-rsinput-controller.yaml' 'sm8550-gamepad.yaml'
        'AYN-Odin2.conf' 'SM8550-RetroidPocket-I2S.conf' 'HiFi.conf'
        'SM8550-RetroidPocket-I2S-tplg.bin'
        '10-pocknix-deeponly.conf' '30-pocknix-cpuidle.conf'
        '50-no-sink-suspend.conf' '52-pocknix-default-volume.conf'
        '99-wcd938x-nosleep.rules'
        'audio-quiesce-pre' 'audio-quiesce-post'
        'kernel-cmdline'
        'pocknix-stick-leds' 'pocknix-stick-ledsd' 'pocknix-stick-leds.service'
        '50-holodor-ip-stub.yaml'
        'pocknix-input-calibration' 'pocknix-input-calibration.service')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm644 "${srcdir}/device.conf" "${pkgdir}/usr/lib/pocknix/device.conf"
  local b
  for b in "${startdir}/boards/"*.conf; do
    install -Dm644 "${b}" "${pkgdir}/usr/lib/pocknix/boards/$(basename "${b}")"
  done

  install -Dm644 "${srcdir}/10-pocknix-deeponly.conf" \
    "${pkgdir}/usr/lib/systemd/sleep.conf.d/10-pocknix-deeponly.conf"
  install -Dm644 "${srcdir}/50-no-sink-suspend.conf" \
    "${pkgdir}/usr/share/wireplumber/wireplumber.conf.d/50-no-sink-suspend.conf"
  install -Dm644 "${srcdir}/52-pocknix-default-volume.conf" \
    "${pkgdir}/usr/share/wireplumber/wireplumber.conf.d/52-pocknix-default-volume.conf"
  install -Dm644 "${srcdir}/30-pocknix-cpuidle.conf" \
    "${pkgdir}/usr/lib/tmpfiles.d/30-pocknix-cpuidle.conf"

  install -Dm644 "${srcdir}/01-rsinput-controller.yaml" \
    "${pkgdir}/usr/share/inputplumber/devices/01-rsinput-controller.yaml"
  install -Dm644 "${srcdir}/sm8550-gamepad.yaml" \
    "${pkgdir}/usr/share/inputplumber/capability_maps/sm8550-gamepad.yaml"

  local ucm="${pkgdir}/usr/share/alsa/ucm2"
  install -Dm644 "${srcdir}/AYN-Odin2.conf"                "${ucm}/AYN/Odin2/AYN-Odin2.conf"
  install -Dm644 "${srcdir}/HiFi.conf"                     "${ucm}/AYN/Odin2/HiFi.conf"
  install -Dm644 "${srcdir}/SM8550-RetroidPocket-I2S.conf" "${ucm}/RetroidPocket/SM8550/SM8550-RetroidPocket-I2S.conf"
  install -Dm644 "${srcdir}/HiFi.conf"                     "${ucm}/RetroidPocket/SM8550/HiFi.conf"
  install -d "${ucm}/conf.d/sm8550"
  ln -sf "../../AYN/Odin2/AYN-Odin2.conf" "${ucm}/conf.d/sm8550/AYN-Odin2.conf"
  ln -sf "../../RetroidPocket/SM8550/SM8550-RetroidPocket-I2S.conf" "${ucm}/conf.d/sm8550/SM8550-RetroidPocket-I2S.conf"

  install -Dm644 "${srcdir}/SM8550-RetroidPocket-I2S-tplg.bin" \
    "${pkgdir}/usr/lib/firmware/qcom/sm8550/SM8550-RetroidPocket-I2S-tplg.bin"

  install -Dm755 "${srcdir}/pocknix-stick-leds" \
    "${pkgdir}/usr/local/bin/pocknix-stick-leds"
  install -Dm755 "${srcdir}/pocknix-stick-ledsd" \
    "${pkgdir}/usr/local/bin/pocknix-stick-ledsd"
  install -Dm644 "${srcdir}/pocknix-stick-leds.service" \
    "${pkgdir}/usr/lib/systemd/system/pocknix-stick-leds.service"

  install -Dm755 "${srcdir}/pocknix-input-calibration" "${pkgdir}/usr/local/bin/pocknix-input-calibration"
  install -Dm644 "${srcdir}/pocknix-input-calibration.service" \
    "${pkgdir}/usr/lib/systemd/system/pocknix-input-calibration.service"

  # Shadow InputPlumber's built-in configs (same filenames, /etc wins): our
  # 01-rsinput-controller.yaml owns this family.
  local stub
  for stub in 50-retroid_pocket_nova.yaml 50-retroid_pocket6.yaml 50-ayn_odin2.yaml 50-ayn_odin2_mini.yaml 50-ayn_odin3.yaml; do
    install -Dm644 "${srcdir}/50-holodor-ip-stub.yaml" "${pkgdir}/etc/inputplumber/devices.d/${stub}"
  done

  install -Dm644 "${srcdir}/kernel-cmdline" "${pkgdir}/usr/lib/pocknix/kernel-cmdline"
  install -Dm644 "${srcdir}/99-wcd938x-nosleep.rules" \
    "${pkgdir}/usr/lib/udev/rules.d/99-wcd938x-nosleep.rules"
  install -Dm755 "${srcdir}/audio-quiesce-pre" \
    "${pkgdir}/usr/lib/pocknix/sleep.d/pre/002-audio-quiesce"
  install -Dm755 "${srcdir}/audio-quiesce-post" \
    "${pkgdir}/usr/lib/pocknix/sleep.d/post/002-audio-quiesce"
}
