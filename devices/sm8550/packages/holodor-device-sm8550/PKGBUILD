# pocknix-device-sm8550 — metapackage: the complete SM8550 family system.
# Depends on the family BSP + the SoC kernel + the shared session stack.
# Successor to the retired per-device metapackages; 'replaces' migrates
# installed devices (e.g. an internal-installed RP6) on their next pacman -Syu.
pkgname=holodor-device-sm8550
pkgver=0.2.0
pkgrel=2
pkgdesc="pocknix device metapackage: SM8550 family (Retroid Pocket Nova / RP6, AYN Odin 2 family)"
arch=('any')
url="https://github.com/transentient/holodor"
license=('GPL2')
depends=('holodor-bsp-sm8550'
         'linux-holodor-sm8550'
         'holodor-bootloader-sm8550'
         'holodor-steam'
         'holodor-desktop'
         'holodor-emulation'
         'holodor-decky'
         'holodor-sdcard-automount')
# Exactly one device metapackage per install (wrong-device guard, same pattern
# as the BSPs).
provides=('holodor-device' 'pocknix-device' 'pocknix-device-sm8550')
conflicts=('holodor-device' 'pocknix-device' 'pocknix-device-sm8550')
replaces=('pocknix-device-sm8550' 'pocknix-device-rp6' 'pocknix-device-odin2' 'pocknix-device-odin2mini' 'pocknix-device-odin2portal')

package() {
  :   # pure metapackage
}
