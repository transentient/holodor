# pocknix-device-sm8750 — metapackage: the complete SM8750 family system.
# Depends on the family BSP + the SoC kernel + the shared session stack.
# Successor to the retired per-device metapackages; 'replaces' migrates
# installed devices (e.g. an internal-installed RP6) on their next pacman -Syu.
pkgname=pocknix-device-sm8750
pkgver=0.2.0
pkgrel=2
pkgdesc="pocknix device metapackage: SM8750 family (Retroid Pocket 6, AYN Odin 2 family)"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL2')
depends=('pocknix-bsp-sm8750'
         'linux-pocknix-sm8750'
         'pocknix-bootloader-sm8750'   # ROCKNIX ABL folder shipped on the SD
         'pocknix-steam'
         'pocknix-desktop'
         'pocknix-emulation'
         'pocknix-decky'
         'pocknix-sdcard-automount')
# Exactly one device metapackage per install (wrong-device guard, same pattern
# as the BSPs).
provides=('pocknix-device')
conflicts=('pocknix-device')

package() {
  :   # pure metapackage
}
