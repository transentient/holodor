# pocknix-device-sm8250 — metapackage: the complete SM8250 family system.
# Depends on the family BSP + the SoC kernel + the arm-efi bootloader payload +
# the shared session stack. Installing this (and nothing else pocknix-specific)
# turns an ALARM base into pocknix for any sm8250 board (Retroid Pocket 5).
pkgname=holodor-device-sm8250
pkgver=0.1.0
pkgrel=4   # 4: pocknix-gamepad-calibration (GPcal port, upstream fb6c759). 3: proton-cachyos-dxvk2 +
           #    pocknix-dxvk2-donor (a650 DXVK-3 wall; upstream a8b8635/d3b4743)
pkgdesc="pocknix device metapackage: SM8250 family (RP5, RP Flip 2)"
arch=('any')
url="https://github.com/transentient/holodor"
license=('GPL2')
depends=('holodor-bsp-sm8250'
         'linux-holodor-sm8250'
         'holodor-bootloader-sm8250'
         'holodor-steam'
         'proton-cachyos-dxvk2'
         # a6xx donor prep swaps into downloaded Valve ARM Protons (dep edge = delivery)
         'pocknix-dxvk2-donor'
         'pocknix-desktop'
         'pocknix-emulation'
         'pocknix-decky'
         'pocknix-sdcard-automount'
         # sm8250-only: the raw trigger view reads retroid/mangmi ABS_HAT2X/Y, dead on
         # rsinput. A dep edge, not a list entry: -Syu never installs a new package name.
         'pocknix-gamepad-calibration')
# Exactly one device metapackage per install (wrong-device guard, same pattern
# as the BSPs).
provides=('holodor-device' 'pocknix-device' 'pocknix-device-sm8250')
conflicts=('holodor-device' 'pocknix-device' 'pocknix-device-sm8250')
replaces=('pocknix-device-sm8250')

package() {
  :   # pure metapackage
}
