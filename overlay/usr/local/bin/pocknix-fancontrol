#!/bin/sh
# pocknix-fancontrol - fan curve daemon (device-neutral: auto-discovers the hwmon pwm; RP5 sm8250 has one too).
# Ported from ROCKNIX hardware/quirks/platforms/SM8550/bin/fancontrol (+ 005-thermal_path /
# 020-fan_control). Without this nothing takes PWM control of the fan, so it never spins and the
# device cooks. Discovers the hwmon PWM fan + the CPU/GPU thermal zones, then drives pwm1 from a
# curve every few seconds. Runs as root (writes /sys).
#
# Curves (2026-09-08, custom fan curves - design follows ArmadaOS's armada-powerd, GPL-2.0-or-later):
#   A curve is a list of "tempC:pwm" points (pwm 0-255). Between points the speed is interpolated
#   linearly; below the first point the first pwm applies, above the last point the last pwm.
#   Built-in curves: quiet (default), moderate, performance (= ROCKNIX's "aggressive"), max.
#   User curves live in /etc/pocknix/fan-curves/<name>.curve (line 1 = label, line 2 = points),
#   written by Pocknix Control. The active curve name is /var/lib/pocknix/fan-mode, re-read every
#   tick, so switching is a bare file write (pocknix-fan-mode / the plugin) - no restart.
#   Temperature = the HOTTEST cpu/gpu zone (telemetry caught a 95C GPU hotspot hidden by an
#   average of cool zones, 2026-08-08), smoothed with an EMA so the fan does not chase every
#   sample; speed changes are rate-limited (fast up, slow down) so the fan glides instead of
#   hunting. The written PWM is read back every tick and re-asserted if the hardware lost it
#   (post-resume the fan sat at 0 for minutes on 2026-09-01 - the old daemon only wrote on change).
set -u

MODE_FILE=/var/lib/pocknix/fan-mode
CURVE_DIR=/etc/pocknix/fan-curves
TICK=3
RAMP_UP=40      # max pwm increase per tick
RAMP_DOWN=8     # max pwm decrease per tick
ALPHA=50        # EMA weight (%) of the newest temperature sample

# Fan PWM (hwmon pwm1) - ROCKNIX 020-fan_control.
FAN_PWM="$(ls /sys/class/hwmon/hwmon*/pwm1 2>/dev/null | head -1)"
[ -n "${FAN_PWM}" ] || { echo "pocknix-fancontrol: no hwmon pwm1 fan found, exiting"; exit 0; }
FAN_EN="${FAN_PWM}_enable"

# CPU + GPU thermal zones only - ROCKNIX 005-thermal_path. gpu* (not gpuss*):
# sm8550 zones are gpuss-N-thermal but sm8250's GPU zone is gpu-top-thermal.
SENSORS=""
for z in /sys/devices/virtual/thermal/thermal_zone*/; do
  case "$(cat "${z}type" 2>/dev/null)" in
    cpu*|gpu*) SENSORS="${SENSORS} ${z}temp" ;;
  esac
done
[ -n "${SENSORS}" ] || { echo "pocknix-fancontrol: no cpu/gpu thermal zones, exiting"; exit 0; }

# Built-in curves. Same speed steps ROCKNIX uses (51 77 102 119 153 204 255); only the
# temperatures shift between quiet / moderate / performance. Keep in sync with the plugin's
# FACTORY table (py_modules/pocknix_control/fan_curves.py).
factory_curve() {
  case "$1" in
    max)         echo "0:255" ;;
    performance) echo "48:0,50:51,55:77,60:102,65:119,70:153,75:204,80:255" ;;
    moderate)    echo "53:0,55:51,60:77,65:102,70:119,75:153,80:204,85:255" ;;
    quiet)       echo "58:0,60:51,65:77,70:102,75:119,80:153,85:204,95:255" ;;
    *) return 1 ;;
  esac
}

# Resolve the active curve: built-in name, else a user curve file, else quiet.
# Prints "<name> <points>" (runs in a subshell, so it cannot set variables for the caller).
active_curve() {
  m="$(cat "${MODE_FILE}" 2>/dev/null | head -1 | tr -d '[:space:]')"
  case "${m}" in ""|*[!a-z0-9_]*) m=quiet ;; esac
  if c="$(factory_curve "${m}")"; then echo "${m} ${c}"; return; fi
  if [ -r "${CURVE_DIR}/${m}.curve" ]; then
    c="$(sed -n 2p "${CURVE_DIR}/${m}.curve" | tr -d '[:space:]')"
    case "${c}" in *[0-9]:[0-9]*) echo "${m} ${c}"; return ;; esac
  fi
  echo "quiet(fallback-from-${m}) $(factory_curve quiet)"
}

# Take manual PWM control; restore automatic on exit.
[ -e "${FAN_EN}" ] && echo 1 > "${FAN_EN}" 2>/dev/null
trap '[ -e "${FAN_EN}" ] && echo 0 > "${FAN_EN}" 2>/dev/null; exit 0' INT TERM

LAST="$(cat "${FAN_PWM}" 2>/dev/null || echo 0)"
case "${LAST}" in ''|*[!0-9]*) LAST=0 ;; esac
SMOOTH=""
ANNOUNCED=""
while :; do
  set -- $(active_curve); ACTIVE="$1"; CURVE="$2"
  if [ "${ACTIVE}" != "${ANNOUNCED}" ]; then
    echo "pocknix-fancontrol: curve '${ACTIVE}' = ${CURVE}"
    ANNOUNCED="${ACTIVE}"
  fi
  RAW="$(awk '{if($1>m)m=$1} END{printf "%.1f", m/1000}' ${SENSORS} 2>/dev/null)"
  [ -n "${SMOOTH}" ] || SMOOTH="${RAW}"
  # EMA on the temperature, then linear interpolation on the curve, then the ramp limit.
  set -- $(awk -v raw="${RAW}" -v prev="${SMOOTH}" -v alpha="${ALPHA}" -v c="${CURVE}" \
               -v last="${LAST}" -v up="${RAMP_UP}" -v down="${RAMP_DOWN}" 'BEGIN{
    t = prev + (raw - prev) * alpha / 100
    n = split(c, a, ",")
    for (i = 1; i <= n; i++) { split(a[i], p, ":"); x[i] = p[1] + 0; y[i] = p[2] + 0 }
    for (i = 2; i <= n; i++) { xv = x[i]; yv = y[i]; j = i - 1
      while (j > 0 && x[j] > xv) { x[j+1] = x[j]; y[j+1] = y[j]; j-- }
      x[j+1] = xv; y[j+1] = yv }
    if (t <= x[1]) r = y[1]
    else if (t >= x[n]) r = y[n]
    else for (i = 1; i < n; i++) if (t >= x[i] && t <= x[i+1]) {
      r = (x[i+1] == x[i]) ? y[i+1] : y[i] + (y[i+1] - y[i]) * (t - x[i]) / (x[i+1] - x[i]); break }
    r = int(r + 0.5); if (r < 0) r = 0; if (r > 255) r = 255
    if (r > last + up) r = last + up
    if (r < last - down) r = last - down
    printf "%.1f %d", t, r }')
  SMOOTH="$1"; SPEED="$2"
  # Re-assert if the hardware lost our setting (resume), else write only on change.
  HW="$(cat "${FAN_PWM}" 2>/dev/null || echo -1)"
  if [ "${SPEED}" != "${LAST}" ] || [ "${HW}" != "${LAST}" ]; then
    [ -e "${FAN_EN}" ] && [ "$(cat "${FAN_EN}" 2>/dev/null)" != 1 ] && echo 1 > "${FAN_EN}" 2>/dev/null
    echo "${SPEED}" > "${FAN_PWM}" 2>/dev/null
    LAST="${SPEED}"
  fi
  sleep "${TICK}"
done
