From 76ff3d0cfc40a8a99868f3dffd5d099c105c77bd Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Mon, 7 Sep 2026 12:36:15 +0700
Subject: [PATCH] ASoC: qdsp6: q6apm-lpass: start MI2S RX port at prepare

Port start moved from .prepare to .trigger, so the MI2S bit-clock now
starts after the codec DAPM widgets power up. The aw88166 amps on Odin 2
and Retroid Pocket 6 check their PLL against BCLK at DAPM PRE_PMU,
before the trigger, and fail PLL lock with no clock, leaving the
speakers silent.

Start the MI2S playback port at prepare again so BCLK is up before
PRE_PMU. The trigger's !is_port_started guard no-ops; capture and
non-MI2S backends are unchanged.

Signed-off-by: Teguh Sobirin <teguh@sobir.in>
---
 sound/soc/qcom/qdsp6/q6apm-lpass-dais.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c b/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c
--- a/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c
+++ b/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c
@@ -224,6 +224,23 @@ static int q6apm_lpass_dai_prepare(struct snd_pcm_substream *substream, struct s
 		dev_err(dai->dev, "Failed to prepare Graph %d\n", rc);
 		goto err;
 	}
+
+	/*
+	 * aw88166 checks its PLL against BCLK at DAPM PRE_PMU, before the
+	 * PCM trigger; start the port here so BCLK is up in time. The
+	 * trigger's !is_port_started guard then no-ops. Playback MI2S only.
+	 */
+	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK &&
+	    ((dai->id >= PRIMARY_MI2S_RX && dai->id <= QUATERNARY_MI2S_TX) ||
+	     (dai->id >= QUINARY_MI2S_RX &&
+	      dai->id <= QUINARY_MI2S_TX))) {
+		rc = q6apm_graph_start(dai_data->graph[dai->id]);
+		if (rc < 0) {
+			dev_err(dai->dev, "Failed to start APM port %d\n", dai->id);
+			goto err;
+		}
+		dai_data->is_port_started[dai->id] = true;
+	}
 	return 0;
 err:
 	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
