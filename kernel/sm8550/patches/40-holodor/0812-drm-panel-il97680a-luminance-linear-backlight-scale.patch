From: virtudude <virtudude@protonmail.com>
Subject: [PATCH] drm/panel: il97680a: expose a luminance-linear backlight scale and 120Hz-only mode

1. Expose a luminance-linear backlight scale ((DBV/3445)^2.4 LUT via
   drm_panel_bl_levels_init / drm_panel_bl_levels_map, BACKLIGHT_SCALE_LINEAR)
   and return the cached brightness in get_brightness() instead of attempting
   a DSI BTA readback on a video-mode panel.
2. Program the mapped cached brightness during il97680a_rpnova_init_sequence()
   and append the missing end of Android's on-sequence (page 0x22 reg 0xE1=1,
   page 0x00) after set_display_on + 20 ms.
3. Expose only the 120Hz mode (.num_modes = 1) so init_sequence at prepare()
   time and DPU scanout timings never desynchronize into a 60Hz/120Hz mismatch.
4. Assert reset_gpio on init_sequence failure in il97680a_prepare().

Ported from ArmadaOS / PortareOS (0106, 1130) + Holodor 1021/0822.
---
--- a/drivers/gpu/drm/panel/panel-ilitek-il97680a.c
+++ b/drivers/gpu/drm/panel/panel-ilitek-il97680a.c
@@ -30,6 +30,7 @@
 
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data *supplies;
+	struct drm_panel_bl_levels bl_levels;
 };
 
 struct panel_desc {
@@ -84,6 +85,11 @@
 static int il97680a_rpnova_init_sequence(struct panel_info *pinfo)
 {
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
+	u16 cached = pinfo->panel.backlight ?
+		     backlight_get_brightness(pinfo->panel.backlight) : 3445;
+	u16 brightness = drm_panel_bl_levels_map(&pinfo->bl_levels, cached);
+	u8 bl_payload[] = { MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
+			    brightness >> 8, brightness & 0xff, 0x00, 0x00 };
 
 	int cur_mode = il97680a_get_current_mode(pinfo);
 	int cur_vrefresh = drm_mode_vrefresh(&pinfo->desc->modes[cur_mode]);
@@ -111,7 +117,7 @@
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
 				     0x20);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
-				     0x0d, 0x75, 0x00, 0x00);
+	mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, bl_payload,
+					ARRAY_SIZE(bl_payload));
 
 	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
 
@@ -121,6 +126,15 @@
 
 	mipi_dsi_msleep(&dsi_ctx, 20);
 
+	/*
+	 * Android's on-command (qcom,mdss_dsi_xingxing_4_5_1280_960_cmd)
+	 * and UEFI DisplayDxe end with page 0x22 register E1 set to 1 and
+	 * a return to page 0x00 for subsequent brightness writes.
+	 */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x22);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xe1, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xff, 0x5a, 0xa5, 0x00);
+
 	return dsi_ctx.accum_err;
 }
 
@@ -153,7 +167,14 @@
 
 static struct panel_desc il97680a_rpnova_desc = {
 	.modes = il97680a_rpnova_modes,
-	.num_modes = ARRAY_SIZE(il97680a_rpnova_modes),
+	/*
+	 * 120Hz only: init_sequence programs the frame-rate register (0x60)
+	 * from il97680a_get_current_mode() at prepare() time. Exposing the
+	 * 60Hz mode causes gamescope to switch DPU timings to 60Hz while the
+	 * panel IC remains configured for 120Hz (or races at prepare() time),
+	 * desynchronizing the video stream and blanking the display.
+	 */
+	.num_modes = 1,
 	.width_mm = 91,
 	.height_mm = 68,
 	.bpc = 8,
@@ -192,6 +213,7 @@
 
 	ret = pinfo->desc->init_sequence(pinfo);
 	if (ret < 0) {
+		gpiod_set_value_cansleep(pinfo->reset_gpio, 1);
 		regulator_bulk_disable(ARRAY_SIZE(panel_supplies), pinfo->supplies);
 		dev_err(panel->dev, "failed to initialize panel: %d\n", ret);
 		return ret;
@@ -285,10 +307,55 @@
 	.get_orientation = il97680a_get_orientation,
 };
 
+/*
+ * The DDIC drives the panel at luminance ~ (DBV/3445)^2.4, measured on the
+ * Retroid Pocket Nova module. Userspace brightness models assume a scale
+ * linear in luminance, so the sysfs value is linear light, mapped to DBV
+ * through these levels.
+ */
+static const u16 il97680a_bl_levels[266] = {
+	   0,  337,  450,  532,  600,  659,  711,  758,
+	 801,  842,  879,  915,  949,  981, 1012, 1041,
+	1070, 1097, 1123, 1149, 1174, 1198, 1221, 1244,
+	1266, 1288, 1309, 1330, 1350, 1370, 1390, 1409,
+	1428, 1446, 1464, 1482, 1500, 1517, 1534, 1550,
+	1567, 1583, 1599, 1615, 1630, 1646, 1661, 1676,
+	1691, 1705, 1720, 1734, 1748, 1762, 1776, 1789,
+	1803, 1816, 1829, 1842, 1855, 1868, 1881, 1893,
+	1906, 1918, 1930, 1943, 1955, 1966, 1978, 1990,
+	2002, 2013, 2025, 2036, 2047, 2058, 2070, 2081,
+	2091, 2102, 2113, 2124, 2134, 2145, 2155, 2166,
+	2176, 2186, 2197, 2207, 2217, 2227, 2237, 2247,
+	2257, 2266, 2276, 2286, 2295, 2305, 2314, 2324,
+	2333, 2342, 2352, 2361, 2370, 2379, 2388, 2397,
+	2406, 2415, 2424, 2433, 2442, 2450, 2459, 2468,
+	2476, 2485, 2494, 2502, 2511, 2519, 2527, 2536,
+	2544, 2552, 2560, 2569, 2577, 2585, 2593, 2601,
+	2609, 2617, 2625, 2633, 2641, 2649, 2656, 2664,
+	2672, 2680, 2687, 2695, 2703, 2710, 2718, 2725,
+	2733, 2740, 2748, 2755, 2763, 2770, 2777, 2785,
+	2792, 2799, 2806, 2814, 2821, 2828, 2835, 2842,
+	2849, 2856, 2863, 2870, 2877, 2884, 2891, 2898,
+	2905, 2912, 2919, 2925, 2932, 2939, 2946, 2953,
+	2959, 2966, 2973, 2979, 2986, 2992, 2999, 3006,
+	3012, 3019, 3025, 3032, 3038, 3045, 3051, 3057,
+	3064, 3070, 3077, 3083, 3089, 3096, 3102, 3108,
+	3114, 3121, 3127, 3133, 3139, 3145, 3151, 3158,
+	3164, 3170, 3176, 3182, 3188, 3194, 3200, 3206,
+	3212, 3218, 3224, 3230, 3236, 3242, 3248, 3253,
+	3259, 3265, 3271, 3277, 3283, 3288, 3294, 3300,
+	3306, 3311, 3317, 3323, 3329, 3334, 3340, 3345,
+	3351, 3357, 3362, 3368, 3374, 3379, 3385, 3390,
+	3396, 3401, 3407, 3412, 3418, 3423, 3429, 3434,
+	3440, 3445
+};
+
 static int il97680a_bl_update_status(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
-	u16 brightness = backlight_get_brightness(bl);
+	struct panel_info *pinfo = mipi_dsi_get_drvdata(dsi);
+	u16 brightness = drm_panel_bl_levels_map(&pinfo->bl_levels,
+						 backlight_get_brightness(bl));
 	int ret;
 
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
@@ -301,18 +368,7 @@
 
 static int il97680a_bl_get_brightness(struct backlight_device *bl)
 {
-	struct mipi_dsi_device *dsi = bl_get_data(bl);
-	u16 brightness;
-	int ret;
-
-	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
-
-	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
-	if (ret < 0)
-		return ret;
-
-	return brightness;
+	return backlight_get_brightness(bl);
 }
 
 static const struct backlight_ops il97680a_bl_ops = {
@@ -327,6 +383,7 @@
 		.type = BACKLIGHT_RAW,
 		.brightness = 3445,
 		.max_brightness = 3445,
+		.scale = BACKLIGHT_SCALE_LINEAR,
 	};
 
 	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
@@ -369,6 +426,12 @@
 
 	pinfo->panel.prepare_prev_first = true;
 
+	ret = drm_panel_bl_levels_init(&pinfo->bl_levels, dev,
+				       il97680a_bl_levels,
+				       ARRAY_SIZE(il97680a_bl_levels), 13, 3445);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to build backlight levels\n");
+
 	pinfo->panel.backlight = il97680a_create_backlight(dsi);
 	if (IS_ERR(pinfo->panel.backlight))
 		return dev_err_probe(dev, PTR_ERR(pinfo->panel.backlight),
