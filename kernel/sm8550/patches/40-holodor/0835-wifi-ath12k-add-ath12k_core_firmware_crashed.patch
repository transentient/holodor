From ef330ed2a7cdbd5ae20ee89ec26f62dda1623822 Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Tue, 8 Sep 2026 22:37:31 +0000
Subject: [PATCH] wifi: ath12k: add ath12k_core_firmware_crashed()

ath12k_core_reset() is only ever queued from the MHI fatal-error path.
A transport whose firmware lives on a remoteproc first hears of a crash
when the QMI server returns, too late for restart_work, which expects
the teardown already done.

Add the teardown as an entry point the transport can call from its
crash notification: the MHI path's pre/post reconfigure recovery and
interrupt disable, minus the power cycle remoteproc performs itself. A
second crash during a restart is folded into it, with a timeout so the
flag cannot latch.

Signed-off-by: Teguh Sobirin <teguh@sobir.in>
---
diff --git a/drivers/net/wireless/ath/ath12k/core.c b/drivers/net/wireless/ath/ath12k/core.c
--- a/drivers/net/wireless/ath/ath12k/core.c
+++ b/drivers/net/wireless/ath/ath12k/core.c
@@ -1625,6 +1625,49 @@
 	complete(&ab->driver_recovery);
 }
 
+/* Crash teardown for a firmware restarted outside ath12k (WPSS remoteproc). */
+void ath12k_core_firmware_crashed(struct ath12k_base *ab)
+{
+	if (!test_bit(ATH12K_FLAG_QMI_FW_READY_COMPLETE, &ab->dev_flags)) {
+		ath12k_warn(ab, "ignore firmware crash, dev flags 0x%lx\n",
+			    ab->dev_flags);
+		return;
+	}
+
+	/* fold a second crash into the restart under way */
+	if (test_bit(ATH12K_FLAG_CRASH_IN_FLIGHT, &ab->dev_flags)) {
+		if (time_before(jiffies, ab->crash_in_flight_at +
+					 ATH12K_CRASH_IN_FLIGHT_TIMEOUT)) {
+			ath12k_warn(ab, "firmware crashed again %ums into a restart, folding into it\n",
+				    jiffies_to_msecs(jiffies - ab->crash_in_flight_at));
+			return;
+		}
+
+		ath12k_warn(ab, "previous restart stuck for %ums, tearing down again\n",
+			    jiffies_to_msecs(jiffies - ab->crash_in_flight_at));
+	}
+
+	set_bit(ATH12K_FLAG_CRASH_IN_FLIGHT, &ab->dev_flags);
+	ab->crash_in_flight_at = jiffies;
+
+	ath12k_warn(ab, "firmware crashed, tearing down for restart\n");
+
+	/* is_reset gates CRASH_FLUSH and the ieee80211_restart_hw() hand-back */
+	ab->is_reset = true;
+	atomic_set(&ab->recovery_count, 0);
+	atomic_inc(&ab->reset_count);
+
+	ath12k_core_pre_reconfigure_recovery(ab);
+	ath12k_core_post_reconfigure_recovery(ab);
+
+	ath12k_hif_irq_disable(ab);
+	ath12k_hif_ce_irq_disable(ab);
+
+	/* prepare for the QMI handshake that follows the restart */
+	ab->qmi.num_radios = U8_MAX;
+}
+EXPORT_SYMBOL(ath12k_core_firmware_crashed);
+
 static void ath12k_core_restart(struct work_struct *work)
 {
 	struct ath12k_base *ab = container_of(work, struct ath12k_base, restart_work);
@@ -1635,6 +1678,7 @@
 	ret = ath12k_core_reconfigure_on_crash(ab);
 	if (ret) {
 		ath12k_err(ab, "failed to reconfigure driver on crash recovery\n");
+		clear_bit(ATH12K_FLAG_CRASH_IN_FLIGHT, &ab->dev_flags);
 		return;
 	}
 
@@ -1663,6 +1707,7 @@
 	}
 
 exit_restart:
+	clear_bit(ATH12K_FLAG_CRASH_IN_FLIGHT, &ab->dev_flags);
 	complete(&ab->restart_completed);
 }
 
diff --git a/drivers/net/wireless/ath/ath12k/core.h b/drivers/net/wireless/ath/ath12k/core.h
--- a/drivers/net/wireless/ath/ath12k/core.h
+++ b/drivers/net/wireless/ath/ath12k/core.h
@@ -61,6 +61,8 @@
 
 #define ATH12K_MON_TIMER_INTERVAL  10
 #define ATH12K_RESET_TIMEOUT_HZ			(20 * HZ)
+/* after this a further crash tears down again instead of folding */
+#define ATH12K_CRASH_IN_FLIGHT_TIMEOUT		(10 * HZ)
 #define ATH12K_RESET_MAX_FAIL_COUNT_FIRST	3
 #define ATH12K_RESET_MAX_FAIL_COUNT_FINAL	5
 #define ATH12K_RESET_FAIL_TIMEOUT_HZ		(20 * HZ)
@@ -282,6 +284,7 @@
 	ATH12K_FLAG_QMI_FW_READY_COMPLETE,
 	ATH12K_FLAG_FTM_SEGMENTED,
 	ATH12K_FLAG_FIXED_MEM_REGION,
+	ATH12K_FLAG_CRASH_IN_FLIGHT,
 };
 
 struct ath12k_tx_conf {
@@ -1097,6 +1100,7 @@
 	} fw;
 
 	struct completion restart_completed;
+	unsigned long crash_in_flight_at;
 
 #ifdef CONFIG_ACPI
 
@@ -1261,6 +1265,7 @@
 int ath12k_core_check_dt(struct ath12k_base *ath12k);
 int ath12k_core_check_smbios(struct ath12k_base *ab);
 void ath12k_core_halt(struct ath12k *ar);
+void ath12k_core_firmware_crashed(struct ath12k_base *ab);
 int ath12k_core_resume_early(struct ath12k_base *ab);
 int ath12k_core_resume(struct ath12k_base *ab);
 int ath12k_core_suspend(struct ath12k_base *ab);
