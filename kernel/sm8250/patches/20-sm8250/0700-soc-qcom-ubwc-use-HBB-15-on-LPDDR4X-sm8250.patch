+/**
+ * qcom_smem_dram_is_lpddr4(): Whether SMEM reports an LPDDR4/LPDDR4X part
+ *
+ * Context: Check qcom_smem_is_available() before calling this function.
+ *
+ * Return: 1 for LPDDR4/LPDDR4X, 0 for any other known type, -ENODATA if
+ * the DDR information couldn't be found/interpreted.
+ */
+int qcom_smem_dram_is_lpddr4(void)
+{
+	if (!__dram || !__dram->type)
+		return -ENODATA;
+
+	return __dram->type == DDR_TYPE_LPDDR4 || __dram->type == DDR_TYPE_LPDDR4X;
+}
+EXPORT_SYMBOL_GPL(qcom_smem_dram_is_lpddr4);
