From 26ce1faa1b9f81dffc0f8e8e1671e68a9b135c6b Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Mon, 19 Oct 2026 15:29:21 +0700
Subject: [PATCH] ASoC: codecs: lpass-tx-macro: fix SWR_MIC10/11 routes of TX
 SMIC MUX0

On LPASS v9.2 and later the SWR_MIC10 and SWR_MIC11 inputs of TX SMIC MUX0
are routed to TX SWR_INPUT11 and TX SWR_INPUT10 respectively, while all the
other SMIC muxes use the matching input. Selecting SWR_MIC10 on DEC0 then
leaves the DAPM path to the codec feeding SWR input 10 disconnected, so the
microphone behind it is never powered up.

Route SWR_MIC10 and SWR_MIC11 to their own inputs.

Fixes: d34f0c8ee2e3 ("ASoC: codecs: tx-macro: correct TX SMIC MUXn widgets on SM8350+")

Signed-off-by: Teguh Sobirin <teguh@sobir.in>
---
 sound/soc/codecs/lpass-tx-macro.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/sound/soc/codecs/lpass-tx-macro.c b/sound/soc/codecs/lpass-tx-macro.c
index a8e83eb60ba2d7..4a3ad2ccb0396b 100644
--- a/sound/soc/codecs/lpass-tx-macro.c
+++ b/sound/soc/codecs/lpass-tx-macro.c
@@ -1918,8 +1918,8 @@ static const struct snd_soc_dapm_route tx_audio_map_v9_2[] = {
 	{"TX SMIC MUX0", "SWR_MIC7", "TX SWR_INPUT7"},
 	{"TX SMIC MUX0", "SWR_MIC8", "TX SWR_INPUT8"},
 	{"TX SMIC MUX0", "SWR_MIC9", "TX SWR_INPUT9"},
-	{"TX SMIC MUX0", "SWR_MIC10", "TX SWR_INPUT11"},
-	{"TX SMIC MUX0", "SWR_MIC11", "TX SWR_INPUT10"},
+	{"TX SMIC MUX0", "SWR_MIC10", "TX SWR_INPUT10"},
+	{"TX SMIC MUX0", "SWR_MIC11", "TX SWR_INPUT11"},
 
 	{"TX DEC1 MUX", "SWR_MIC", "TX SMIC MUX1"},
 	{"TX SMIC MUX1", NULL, "TX_SWR_CLK"},
