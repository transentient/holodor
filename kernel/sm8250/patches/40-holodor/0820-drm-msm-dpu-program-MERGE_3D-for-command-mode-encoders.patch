From b547718c91dbaf8fe27745afced8de00d1f7415b Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Mon, 5 Oct 2026 16:44:51 +0700
Subject: [PATCH] drm/msm/dpu: program MERGE_3D for command mode encoders

When a single-interface display is wider than MAX_HDISPLAY_SPLIT and
does not use DSC, dpu_crtc_get_topology() reserves two layer mixers
and relies on the MERGE_3D block to stitch the two halves back together
in front of the interface.

The video mode physical encoder handles this: it passes the merge_3d
index to the CTL (CTL_MERGE_3D_ACTIVE), programs MERGE_3D_MODE through
setup_3d_mode() and flushes the block. The command mode physical
encoder only fills in intf_cfg.mode_3d, which the active-CTL (v1)
intf_cfg path ignores, so on DPU 5.0+ the merge block is never enabled
or flushed.

The result is that the pingpong bound to the interface outputs only the
left half of every line while the DSI command engine expects the full
width. The DSI host reports CMD_MDP_FIFO_UNDERFLOW, performs a software
reset, the frame never completes and the encoder ends up in a loop of
kickoff / frame done timeouts, with garbage on the panel.

Configure MERGE_3D in the command mode encoder the same way the video
mode encoder does: pass the merge_3d index to the CTL, program the 3D
mode on the block after binding the pingpong, and add the MERGE_3D
flush at enable time.

Observed with a 1280x960 command mode panel without DSC on Eliza and
SM8550.

Signed-off-by: Teguh Sobirin <teguh@sobir.in>
---
 .../gpu/drm/msm/disp/dpu1/dpu_encoder_phys_cmd.c    | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_cmd.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_cmd.c
index 45079ee59cf674..d462b924ae175c 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_cmd.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_cmd.c
@@ -9,6 +9,7 @@
 #include "dpu_encoder_phys.h"
 #include "dpu_hw_interrupts.h"
 #include "dpu_hw_pingpong.h"
+#include "dpu_hw_merge3d.h"
 #include "dpu_core_irq.h"
 #include "dpu_formats.h"
 #include "dpu_trace.h"
@@ -66,6 +67,8 @@ static void _dpu_encoder_phys_cmd_update_intf_cfg(
 	intf_cfg.stream_sel = cmd_enc->stream_sel;
 	intf_cfg.mode_3d = dpu_encoder_helper_get_3d_blend_mode(phys_enc);
 	intf_cfg.dsc = dpu_encoder_helper_get_dsc(phys_enc);
+	if (intf_cfg.mode_3d && phys_enc->hw_pp->merge_3d)
+		intf_cfg.merge_3d = phys_enc->hw_pp->merge_3d->idx;
 	ctl->ops.setup_intf_cfg(ctl, &intf_cfg);
 
 	/* setup which pp blk will connect to this intf */
@@ -75,6 +78,10 @@ static void _dpu_encoder_phys_cmd_update_intf_cfg(
 				phys_enc->hw_intf,
 				phys_enc->hw_pp->idx);
 
+	if (phys_enc->hw_pp->merge_3d)
+		phys_enc->hw_pp->merge_3d->ops.setup_3d_mode(phys_enc->hw_pp->merge_3d,
+							    intf_cfg.mode_3d);
+
 	if (intf_cfg.dsc != 0)
 		cmd_mode_cfg.data_compress = true;
 
@@ -453,18 +460,24 @@ static void dpu_encoder_phys_cmd_enable_helper(
 		struct dpu_encoder_phys *phys_enc)
 {
 	struct dpu_hw_ctl *ctl;
+	u32 mode_3d;
 
 	if (!phys_enc->hw_pp) {
 		DPU_ERROR("invalid arg(s), encoder %d\n", phys_enc != NULL);
 		return;
 	}
 
+	mode_3d = dpu_encoder_helper_get_3d_blend_mode(phys_enc);
+
 	dpu_encoder_helper_split_config(phys_enc, phys_enc->hw_intf->idx);
 
 	_dpu_encoder_phys_cmd_pingpong_config(phys_enc);
 
 	ctl = phys_enc->hw_ctl;
 	ctl->ops.update_pending_flush_intf(ctl, phys_enc->hw_intf->idx);
+	if (mode_3d && ctl->ops.update_pending_flush_merge_3d &&
+	    phys_enc->hw_pp->merge_3d)
+		ctl->ops.update_pending_flush_merge_3d(ctl, phys_enc->hw_pp->merge_3d->idx);
 }
 
 static void dpu_encoder_phys_cmd_enable(struct dpu_encoder_phys *phys_enc)
