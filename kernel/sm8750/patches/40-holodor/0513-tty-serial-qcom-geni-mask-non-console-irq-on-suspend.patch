From: suckbluefrog <suckbluefrog@proton.me>
Date: Fri, 10 Jul 2026 00:00:00 +000
Subject: [PATCH] tty: serial: qcom-geni: mask non-console IRQ across suspend

A peer that keeps streaming into a non-console GENI UART during suspend can
storm the RX IRQ once uart_suspend_port() marks the port suspended. Mask the
main IRQ around the system-sleep transition so the spurious IRQ detector cannot
permanently disable the gamepad UART. Exclude console and wake-capable UARTs,
and track the extra disable reference so resume only balances what suspend did.

diff --git a/drivers/tty/serial/qcom_geni_serial.c b/drivers/tty/serial/qcom_geni_serial.c
--- a/drivers/tty/serial/qcom_geni_serial.c
+++ b/drivers/tty/serial/qcom_geni_serial.c
@@ -147,6 +147,7 @@ struct qcom_geni_serial_port {
 	bool rx_tx_swap;
 	bool cts_rts_swap;
 	bool manual_flow;
+	bool irq_masked_for_suspend;
 
 	struct qcom_geni_private_data private_data;
 	const struct qcom_geni_device_data *dev_data;
@@ -1974,8 +1975,11 @@ static int qcom_geni_serial_suspend(struct device *dev)
 	struct qcom_geni_serial_port *port = dev_get_drvdata(dev);
 	struct uart_port *uport = &port->uport;
 	struct qcom_geni_private_data *private_data = uport->private_data;
+	int ret;
 
 	/*
+	 * Console ports stay unmasked so no_console_suspend continues to work.
+	 *
 	 * This is done so we can hit the lowest possible state in suspend
 	 * even with no_console_suspend
 	 */
@@ -1984,7 +1988,19 @@ static int qcom_geni_serial_suspend(struct device *dev)
 		geni_icc_set_tag(&port->se, QCOM_ICC_TAG_ACTIVE_ONLY);
 		geni_icc_set_bw(&port->se);
 	}
-	return uart_suspend_port(private_data->drv, uport);
+
+	port->irq_masked_for_suspend =
+		!uart_console(uport) && !device_may_wakeup(dev);
+	if (port->irq_masked_for_suspend)
+		disable_irq(uport->irq);
+
+	ret = uart_suspend_port(private_data->drv, uport);
+	if (ret && port->irq_masked_for_suspend) {
+		enable_irq(uport->irq);
+		port->irq_masked_for_suspend = false;
+	}
+
+	return ret;
 }
 
 static int qcom_geni_serial_resume(struct device *dev)
@@ -1996,6 +2012,12 @@ static int qcom_geni_serial_resume(struct device *dev)
 	struct qcom_geni_private_data *private_data = uport->private_data;
 
 	ret = uart_resume_port(private_data->drv, uport);
+
+	if (port->irq_masked_for_suspend) {
+		enable_irq(uport->irq);
+		port->irq_masked_for_suspend = false;
+	}
+
 	if (uart_console(uport)) {
 		geni_icc_set_tag(&port->se, QCOM_ICC_TAG_ALWAYS);
 		geni_icc_set_bw(&port->se);
