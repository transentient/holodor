From: Holodor <holodor@transentient.github.io>
Date: Thu, 22 Oct 2026 09:20:00 +0900
Subject: [PATCH] usb: typec: mux: wcd939x-usbss: simultaneous DP AUX + integrated HSJ routing (v5)

v5: Support simultaneous DisplayPort Alt-Mode SBU AUX routing and the
integrated 3.5mm headset jack (HSJ) on AYN Odin 3 (Harmonium v2.0):
- Clear INT_SW_CTRL_1/2/3 (0x45..0x47) and route GSBU1/2 to DISP_AUXP/M via
  EXT_SW_CTRL_1 (0x43 = 0x80 normal / 0x40 reverse) during DisplayPort Alt-Mode,
  configuring WCD_USBSS_DISP_AUXM_THRESH (0x82) OVP threshold.
- When DisplayPort Alt-Mode is active on Harmonium v2.0 (or while the 3.5mm
  jack is plugged), use WCD_USBSS_USB_SS_CNTL_USB_SS_MODE_AATC (mode 2) with
  both SENSE|MIC|AGND switches and SW_DISP_AUXP/M_SBU switches enabled so
  3.5mm headphone audio and DisplayPort AUX operate simultaneously.

Signed-off-by: Holodor <holodor@bonesaw.com>
---
diff --git a/drivers/usb/typec/mux/wcd939x-usbss.c b/drivers/usb/typec/mux/wcd939x-usbss.c
--- a/drivers/usb/typec/mux/wcd939x-usbss.c
+++ b/drivers/usb/typec/mux/wcd939x-usbss.c
@@ -54,6 +54,10 @@
 
 #define WCD_USBSS_DISP_AUXP_CTL_LK_CANCEL_TRK_COEFF			GENMASK(2, 0)
 
+#define WCD_USBSS_DISP_AUXM_THRESH		0x82
+
+#define WCD_USBSS_DISP_AUXM_THRESH_DISP_AUXM_OVPON_CM			GENMASK(7, 5)
+
 #define WCD_USBSS_CPLDO_CTL2			0xa1
 
 #define WCD_USBSS_SWITCH_SETTINGS_ENABLE	0x403
@@ -115,6 +119,32 @@
 #define WCD_USBSS_USB_SS_CNTL_USB_SS_MODE_AATC		2
 #define WCD_USBSS_USB_SS_CNTL_USB_SS_MODE_USB		5
 
+/*
+ * Vendor HSJ (integrated 3.5mm headset jack) support — AYN Odin 3.
+ * Names/addresses from Qualcomm downstream wcd939x-i2c.c (msm-6.6);
+ * hardware-validated on the Odin 3 (Harmonium v2.0) 2026-08-13.
+ */
+#define WCD_USBSS_USB_SS_CNTL_USB_SS_MODE_HSJ		1
+
+#define WCD_USBSS_PMP_EN			0x1
+#define WCD_USBSS_PMP_OUT1_HSJ_PWR_EN				BIT(6)
+#define WCD_USBSS_DP_EN				0x1e
+#define WCD_USBSS_DP_BIAS			0x1f
+#define WCD_USBSS_DN_EN				0x21
+#define WCD_USBSS_DN_BIAS			0x22
+#define WCD_USBSS_MG2_MISC_VENDOR		0x2b	/* vendor MG2_MISC; the 0x30 above is not it */
+#define WCD_USBSS_BIAS_TOP			0x2c
+#define WCD_USBSS_EXT_LIN_EN			0x3d
+#define WCD_USBSS_EXT_SW_CTRL_1			0x43
+#define WCD_USBSS_INT_SW_CTRL_1			0x45
+#define WCD_USBSS_INT_SW_CTRL_2			0x46
+#define WCD_USBSS_INT_SW_CTRL_3			0x47
+#define WCD_USBSS_SW_LIN_CTRL_1			0x50
+#define WCD_USBSS_FSM_OVERRIDE			0x63
+#define WCD_USBSS_DC_TRIMCODE_2			0x91
+#define WCD_USBSS_DC_TRIMCODE_3			0x92
+#define WCD_USBSS_CHIP_ID1			0x439
+
 #define WCD_USBSS_AUDIO_FSM_START		0x433
 
 #define WCD_USBSS_AUDIO_FSM_START_AUDIO_FSM_AUDIO_TRIG			BIT(0)
@@ -197,6 +227,7 @@
 	enum typec_orientation orientation;
 	unsigned long mode;
 	unsigned int svid;
+	unsigned int chip_id;
 };
 
 static const struct regmap_range_cfg wcd939x_usbss_ranges[] = {
@@ -237,6 +268,186 @@
 	{ WCD_USBSS_RATIO_SPKR_REXT_R_MSB, GENMASK(6, 0), 0x04 },
 };
 
+
+/*
+ * Route the integrated 3.5mm jack (vendor HSJ_CONNECT sequence).  On the AYN
+ * Odin 3 the jack's lines run through this switch; mainline's AATC routing
+ * does not connect them.  Mode 1 is the vendor's "MBHC mode".  Sequence =
+ * vendor wcd_usbss_pd_pu_enable() + standby exit + the HSJ_CONNECT branch of
+ * wcd_usbss_switch_update().  Audio through the jack verified on hardware in
+ * exactly this state.  (Vendor also writes FUNCTION_ENABLE=0x05 and clears
+ * 0x415 bit7 at init; deliberately not adopted — untested on our hardware.)
+ */
+static int wcd939x_usbss_setup_hsj_common(struct wcd939x_usbss *usbss,
+					  bool enable_dp)
+{
+	unsigned int val;
+	int ret;
+
+	/* pd_pu_enable: DC bias / pulldown network (MBHC sense path) */
+	ret = regmap_clear_bits(usbss->regmap, WCD_USBSS_PMP_OUT1, BIT(5));
+	if (ret)
+		return ret;
+	ret = regmap_clear_bits(usbss->regmap, WCD_USBSS_BIAS_TOP, BIT(5));
+	if (ret)
+		return ret;
+	ret = regmap_set_bits(usbss->regmap, WCD_USBSS_DP_BIAS, BIT(0));
+	if (ret)
+		return ret;
+	ret = regmap_set_bits(usbss->regmap, WCD_USBSS_DN_BIAS, BIT(0));
+	if (ret)
+		return ret;
+	ret = regmap_set_bits(usbss->regmap, WCD_USBSS_MG1_BIAS, BIT(0));
+	if (ret)
+		return ret;
+	ret = regmap_set_bits(usbss->regmap, WCD_USBSS_MG2_BIAS, BIT(0));
+	if (ret)
+		return ret;
+
+	/* mandatory standby exit, 10ms settle */
+	ret = regmap_read(usbss->regmap, WCD_USBSS_USB_SS_CNTL, &val);
+	if (ret)
+		return ret;
+	if (val & WCD_USBSS_USB_SS_CNTL_STANDBY_STATE) {
+		ret = regmap_clear_bits(usbss->regmap, WCD_USBSS_USB_SS_CNTL,
+					WCD_USBSS_USB_SS_CNTL_STANDBY_STATE);
+		if (ret)
+			return ret;
+		msleep(10);
+	}
+
+	ret = regmap_write(usbss->regmap, WCD_USBSS_PMP_EN, 0x0f);
+	if (ret)
+		return ret;
+	ret = regmap_write(usbss->regmap, WCD_USBSS_EXT_SW_CTRL_1, 0x00);
+	if (ret)
+		return ret;
+	ret = regmap_write(usbss->regmap, WCD_USBSS_EXT_LIN_EN, 0xc4);
+	if (ret)
+		return ret;
+	ret = regmap_write(usbss->regmap, WCD_USBSS_SW_LIN_CTRL_1, 0x01);
+	if (ret)
+		return ret;
+	ret = regmap_write(usbss->regmap, WCD_USBSS_DC_TRIMCODE_2, 0x3c);
+	if (ret)
+		return ret;
+	ret = regmap_write(usbss->regmap, WCD_USBSS_DC_TRIMCODE_3, 0x0f);
+	if (ret)
+		return ret;
+
+	/* Harmonium 2.0 only */
+	if (usbss->chip_id == 1) {
+		ret = regmap_set_bits(usbss->regmap, WCD_USBSS_PMP_OUT1,
+				      WCD_USBSS_PMP_OUT1_HSJ_PWR_EN);
+		if (ret)
+			return ret;
+	}
+
+	/*
+	 * Route SENSE->GSBU1 via internal switch override (0x46/0x47), and
+	 * route MIC->MG2 / AGND->MG1 via 0x45 when DisplayPort AUX is not
+	 * active.  Never assert MIC_SWITCHES (BIT(1)) or AGND_SWITCHES (BIT(0))
+	 * in WCD_USBSS_SWITCH_SETTINGS_ENABLE (0x403): doing so causes the
+	 * digital FSM to assert D_AUDIO_EN_OVP (0x70 bit 1), lowering the
+	 * DP/DN OVP threshold to ~2.0V and tripping OVP_DPR (0x402 = 0x80)
+	 * whenever a USB 2.0 device pulls D+ to 3.3V.
+	 */
+	ret = regmap_set_bits(usbss->regmap, WCD_USBSS_INT_SW_CTRL_2, 0x80);
+	if (ret)
+		return ret;
+	ret = regmap_set_bits(usbss->regmap, WCD_USBSS_INT_SW_CTRL_3, 0x02);
+	if (ret)
+		return ret;
+
+	return regmap_write(usbss->regmap, WCD_USBSS_INT_SW_CTRL_1,
+			    enable_dp ? 0x00 : 0xb8);
+}
+
+static int wcd939x_usbss_set_hsj_route(struct wcd939x_usbss *usbss)
+{
+	int ret;
+
+	ret = wcd939x_usbss_setup_hsj_common(usbss, false);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(usbss->regmap, WCD_USBSS_USB_SS_CNTL,
+				 WCD_USBSS_USB_SS_CNTL_USB_SS_MODE,
+				 FIELD_PREP(WCD_USBSS_USB_SS_CNTL_USB_SS_MODE,
+					    WCD_USBSS_USB_SS_CNTL_USB_SS_MODE_HSJ));
+	if (ret)
+		return ret;
+
+	ret = regmap_clear_bits(usbss->regmap, WCD_USBSS_EQUALIZER1,
+				WCD_USBSS_EQUALIZER1_EQ_EN);
+	if (ret)
+		return ret;
+
+	/*
+	 * Keep DNL->DN and DPR->DP selected and enabled in idle/HSJ mode
+	 * (matching vendor wcd-usbss-i2c.c), and clear DP_AUXP/M.
+	 */
+	ret = regmap_update_bits(usbss->regmap, WCD_USBSS_SWITCH_SELECT0,
+				 WCD_USBSS_SWITCH_SELECT0_DP_AUXP_SWITCHES |
+				 WCD_USBSS_SWITCH_SELECT0_DP_AUXM_SWITCHES |
+				 WCD_USBSS_SWITCH_SELECT0_DPR_SWITCHES |
+				 WCD_USBSS_SWITCH_SELECT0_DNL_SWITCHES |
+				 WCD_USBSS_SWITCH_SELECT0_SENSE_SWITCHES |
+				 WCD_USBSS_SWITCH_SELECT0_MIC_SWITCHES,
+				 FIELD_PREP(WCD_USBSS_SWITCH_SELECT0_DNL_SWITCHES,
+					    WCD_USBSS_SWITCH_SELECT0_DNL_SWITCH_DN) |
+				 FIELD_PREP(WCD_USBSS_SWITCH_SELECT0_DPR_SWITCHES,
+					    WCD_USBSS_SWITCH_SELECT0_DPR_SWITCH_DP) |
+				 WCD_USBSS_SWITCH_SELECT0_MIC_SWITCHES);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(usbss->regmap, WCD_USBSS_SWITCH_SELECT1,
+				 WCD_USBSS_SWITCH_SELECT1_AGND_SWITCHES, 0);
+	if (ret)
+		return ret;
+	ret = regmap_clear_bits(usbss->regmap, WCD_USBSS_MG1_BIAS,
+				WCD_USBSS_MG1_BIAS_PCOMP_DYN_BST_EN);
+	if (ret)
+		return ret;
+
+	return regmap_update_bits(usbss->regmap,
+				  WCD_USBSS_SWITCH_SETTINGS_ENABLE,
+				  WCD_USBSS_SWITCH_SETTINGS_ENABLE_DP_AUXP_TO_MGX_SWITCHES |
+				  WCD_USBSS_SWITCH_SETTINGS_ENABLE_DP_AUXM_TO_MGX_SWITCHES |
+				  WCD_USBSS_SWITCH_SETTINGS_ENABLE_DNL_SWITCHES |
+				  WCD_USBSS_SWITCH_SETTINGS_ENABLE_DPR_SWITCHES |
+				  WCD_USBSS_SWITCH_SETTINGS_ENABLE_SENSE_SWITCHES |
+				  WCD_USBSS_SWITCH_SETTINGS_ENABLE_MIC_SWITCHES |
+				  WCD_USBSS_SWITCH_SETTINGS_ENABLE_AGND_SWITCHES,
+				  WCD_USBSS_SWITCH_SETTINGS_ENABLE_DNL_SWITCHES |
+				  WCD_USBSS_SWITCH_SETTINGS_ENABLE_DPR_SWITCHES |
+				  WCD_USBSS_SWITCH_SETTINGS_ENABLE_SENSE_SWITCHES);
+}
+
+/*
+ * Vendor probe one-offs (OVP fuse / MG-rail config) the mainline init does
+ * not perform.  Without these the MG (SBU) OVP FETs are not configured the
+ * way vendor Android runs them.  Also fixes MG2_MISC boost: mainline wrote
+ * it to 0x30, the vendor address is 0x2b.
+ */
+static void wcd939x_usbss_vendor_hw_init(struct wcd939x_usbss *usbss)
+{
+	regmap_set_bits(usbss->regmap, WCD_USBSS_FSM_OVERRIDE, 0x77);
+	regmap_update_bits(usbss->regmap, WCD_USBSS_DP_EN, 0x0e, 0x08);
+	regmap_update_bits(usbss->regmap, WCD_USBSS_DN_EN, 0x0e, 0x08);
+	regmap_set_bits(usbss->regmap, WCD_USBSS_MG1_EN, 0x0c);
+	regmap_set_bits(usbss->regmap, WCD_USBSS_MG2_EN, 0x0c);
+	if (usbss->chip_id == 1) {	/* Harmonium 2.0 */
+		regmap_clear_bits(usbss->regmap, WCD_USBSS_MG1_EN,
+				  WCD_USBSS_MG1_EN_CT_SNS_EN);
+		regmap_clear_bits(usbss->regmap, WCD_USBSS_MG2_EN,
+				  WCD_USBSS_MG2_EN_CT_SNS_EN);
+	}
+	regmap_set_bits(usbss->regmap, WCD_USBSS_DP_DN_MISC1, 0x09);
+	regmap_set_bits(usbss->regmap, WCD_USBSS_MG1_MISC, 0x24);
+	regmap_set_bits(usbss->regmap, WCD_USBSS_MG2_MISC_VENDOR, 0x24);
+}
+
 static int wcd939x_usbss_set(struct wcd939x_usbss *usbss)
 {
 	bool reverse = (usbss->orientation == TYPEC_ORIENTATION_REVERSE);
@@ -245,6 +456,22 @@
 	bool enable_dp = false;
 	int ret;
 
+	/*
+	 * Idle/safe: park the switch in vendor HSJ routing so the integrated
+	 * 3.5mm jack reaches the codec.  Any real Type-C mode below overrides
+	 * while a cable is attached.
+	 */
+	if (usbss->mode == TYPEC_STATE_SAFE)
+		return wcd939x_usbss_set_hsj_route(usbss);
+
+	/*
+	 * No cable at all: the boot-time pmic-glink altmode notification
+	 * reports mode=USB even with nothing attached.  An unattached port
+	 * has no orientation, so trust that instead of the claimed mode.
+	 */
+	if (usbss->orientation == TYPEC_ORIENTATION_NONE)
+		return wcd939x_usbss_set_hsj_route(usbss);
+
 	/* USB Mode */
 	if (usbss->mode < TYPEC_STATE_MODAL ||
 	    (!usbss->svid && (usbss->mode == TYPEC_MODE_USB2 ||
@@ -460,6 +687,19 @@
 	if (ret)
 		return ret;
 
+	/*
+	 * Keep the integrated 3.5mm headset jack (HSJ) charge pump, linearizer,
+	 * and SENSE->GSBU1 path active while USB/DP cables are connected.
+	 */
+	ret = wcd939x_usbss_setup_hsj_common(usbss, enable_dp);
+	if (ret)
+		return ret;
+
+	ret = regmap_set_bits(usbss->regmap, WCD_USBSS_SWITCH_SETTINGS_ENABLE,
+			      WCD_USBSS_SWITCH_SETTINGS_ENABLE_SENSE_SWITCHES);
+	if (ret)
+		return ret;
+
 	/* Enable USB muxes */
 	if (enable_usb) {
 		/* Do not enable Equalizer in safe mode */
@@ -491,11 +731,11 @@
 
 	/* Enable DP AUX muxes */
 	if (enable_dp) {
-		/* Update Leakage Canceller Coefficient for AUXP pins */
+		/* Update Leakage Canceller Coefficient for AUXP pins (vendor uses 1) */
 		ret = regmap_update_bits(usbss->regmap, WCD_USBSS_DISP_AUXP_CTL,
 					 WCD_USBSS_DISP_AUXP_CTL_LK_CANCEL_TRK_COEFF,
 					 FIELD_PREP(WCD_USBSS_DISP_AUXP_CTL_LK_CANCEL_TRK_COEFF,
-						    5));
+						    1));
 		if (ret)
 			return ret;
 
@@ -504,6 +744,11 @@
 		if (ret)
 			return ret;
 
+		ret = regmap_set_bits(usbss->regmap, WCD_USBSS_DISP_AUXM_THRESH,
+				      WCD_USBSS_DISP_AUXM_THRESH_DISP_AUXM_OVPON_CM);
+		if (ret)
+			return ret;
+
 		if (reverse)
 			/* Select MG2 for AUXP and MG1 for AUXM */
 			ret = regmap_update_bits(usbss->regmap, WCD_USBSS_SWITCH_SELECT0,
@@ -695,6 +940,12 @@
 	if (ret)
 		goto err_regulator_disable;
 
+	ret = regmap_read(usbss->regmap, WCD_USBSS_CHIP_ID1, &usbss->chip_id);
+	if (ret)
+		usbss->chip_id = 0;
+
+	wcd939x_usbss_vendor_hw_init(usbss);
+
 	/* Setup in SAFE mode */
 	ret = wcd939x_usbss_set(usbss);
 	if (ret)
@@ -772,9 +1023,12 @@
 	if (!usbss)
 		return -ENODEV;
 
+	/*
+	 * Re-apply the current routing (which always keeps the integrated
+	 * 3.5mm HSJ charge pump, linearizer, and sense path enabled) without
+	 * clobbering any active Type-C USB or DisplayPort Alt-Mode state.
+	 */
 	mutex_lock(&usbss->lock);
-	usbss->mode = enable ? TYPEC_MODE_AUDIO : TYPEC_STATE_SAFE;
-	usbss->svid = 0;
 	ret = wcd939x_usbss_set(usbss);
 	mutex_unlock(&usbss->lock);
 
