From ca800f8cd0e2b19ffca0df6a5fdbeea312ddb479 Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Tue, 8 Sep 2026 22:37:20 +0000
Subject: [PATCH] wifi: ath12k: keep the CE interrupt mask balanced across
 restarts

disable_irq_nosync() nests, so a second bulk disable against one enable
leaves the CE interrupts masked deeper than anything unmasks them. Make
the bulk disable idempotent on ATH12K_FLAG_CE_IRQ_ENABLED, and when a
pending CE work item is cancelled, restore the enable_irq() that the
handler had deferred to it.

Signed-off-by: Teguh Sobirin <teguh@sobir.in>
---
 drivers/net/wireless/ath/ath12k/pci.c | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/drivers/net/wireless/ath/ath12k/pci.c b/drivers/net/wireless/ath/ath12k/pci.c
index 6fc387a121a73d..3cace276cb8df4 100644
--- a/drivers/net/wireless/ath/ath12k/pci.c
+++ b/drivers/net/wireless/ath/ath12k/pci.c
@@ -375,7 +375,9 @@ static void ath12k_pci_ce_irqs_disable(struct ath12k_base *ab)
 {
 	int i;
 
-	clear_bit(ATH12K_FLAG_CE_IRQ_ENABLED, &ab->dev_flags);
+	/* Idempotent: disable_irq_nosync() nests. */
+	if (!test_and_clear_bit(ATH12K_FLAG_CE_IRQ_ENABLED, &ab->dev_flags))
+		return;
 
 	for (i = 0; i < ab->hw_params->ce_count; i++) {
 		if (ath12k_ce_get_attr_flags(ab, i) & CE_ATTR_DIS_INTR)
@@ -951,7 +953,9 @@ static void ath12k_pci_cancel_workqueue(struct ath12k_base *ab)
 		if (ath12k_ce_get_attr_flags(ab, i) & CE_ATTR_DIS_INTR)
 			continue;
 
-		cancel_work_sync(&ce_pipe->intr_wq);
+		/* the pending work owns the handler's enable_irq() */
+		if (cancel_work_sync(&ce_pipe->intr_wq))
+			enable_irq(ab->irq_num[ATH12K_PCI_IRQ_CE0_OFFSET + i]);
 	}
 }
 
