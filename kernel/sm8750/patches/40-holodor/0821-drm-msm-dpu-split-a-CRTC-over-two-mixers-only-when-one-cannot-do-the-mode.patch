From f3f22547d29e4717fd33920492ac3f71debce0ce Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Tue, 6 Oct 2026 16:40:52 +0700
Subject: [PATCH] drm/msm/dpu: split a CRTC over two mixers only when one
 cannot do the mode

dpu_crtc_get_topology() uses two layer mixers (3D merge) for any
non-DSC mode wider than a fixed 1080 pixels, regardless of what a
mixer can actually do. On SoCs with four mixers that exhausts them
quickly: a DSC panel takes two, a second panel wider than 1080 pixels
takes two, and a DisplayPort monitor then fails with "unable to find
appropriate mixers", even though all three would fit.

dpu_crtc_mode_valid() already encodes the real limits of a single
mixer: the mode width must be within max_mixer_width and the
inefficiency-adjusted pixel clock within the maximum core clock rate.
Use the same two conditions to decide the split, so that a mode
needs two mixers only when one mixer cannot process it.

Signed-off-by: Teguh Sobirin <teguh@sobir.in>
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c | 21 +++++++++++++++++----
 1 file changed, 17 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
index 42d0a529b4d515..bb7ce8c0eaed96 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
@@ -1374,7 +1374,20 @@ static int dpu_crtc_reassign_planes(struct drm_crtc *crtc, struct drm_crtc_state
 }
 
 #define MAX_CHANNELS_PER_CRTC PIPES_PER_PLANE
-#define MAX_HDISPLAY_SPLIT 1080
+
+static bool dpu_crtc_needs_lm_split(struct dpu_kms *dpu_kms,
+				    const struct drm_display_mode *mode)
+{
+	u64 adjusted_mode_clk;
+
+	if (mode->hdisplay > dpu_kms->catalog->caps->max_mixer_width)
+		return true;
+
+	adjusted_mode_clk = dpu_core_perf_adjusted_mode_clk(mode->clock,
+							    dpu_kms->perf.perf_cfg);
+
+	return adjusted_mode_clk * 1000 > dpu_kms->perf.max_core_clk_rate;
+}
 
 static struct msm_display_topology dpu_crtc_get_topology(
 		struct drm_crtc *crtc,
@@ -1409,8 +1422,8 @@ static struct msm_display_topology dpu_crtc_get_topology(
 	 * enabled. This is because in cases where CWB is enabled, num_intf will
 	 * count both the WB and real-time phys encoders.
 	 *
-	 * For non-DSC CWB usecases, have the num_lm be decided by the
-	 * (mode->hdisplay > MAX_HDISPLAY_SPLIT) check.
+	 * For non-DSC CWB usecases, have the num_lm be decided by
+	 * dpu_crtc_needs_lm_split().
 	 */
 
 	if (topology.num_intf == 2 && !topology.cwb_enabled)
@@ -1419,7 +1432,7 @@ static struct msm_display_topology dpu_crtc_get_topology(
 		topology.num_lm = 2;
 	else if (dpu_kms->catalog->caps->has_3d_merge &&
 		 topology.num_dsc == 0)
-		topology.num_lm = (mode->hdisplay > MAX_HDISPLAY_SPLIT) ? 2 : 1;
+		topology.num_lm = dpu_crtc_needs_lm_split(dpu_kms, mode) ? 2 : 1;
 	else
 		topology.num_lm = 1;
 
