--- a/src/steamcompmgr.cpp
+++ b/src/steamcompmgr.cpp
@@ -953,6 +953,15 @@
 // Delay to stop modes flickering back and forth.
 static const uint64_t g_uDynamicRefreshDelay = 600'000'000; // 600ms
 
+// dynamic_refresh_default_lowest: with no app target, or with the default "highest rate" target
+// Steam sends for every game, run the panel at its lowest listed rate. A target for any other
+// rate still switches. Initial value from GAMESCOPE_DYNAMIC_REFRESH_DEFAULT_LOWEST; change it at
+// runtime with `gamescopectl dynamic_refresh_default_lowest 0|1` (a per-game "120 Hz" toggle).
+extern bool env_to_bool(const char *env);
+gamescope::ConVar<bool> cv_dynamic_refresh_default_lowest( "dynamic_refresh_default_lowest",
+	env_to_bool( getenv( "GAMESCOPE_DYNAMIC_REFRESH_DEFAULT_LOWEST" ) ),
+	"Run the panel at its lowest refresh rate unless an app target asks for a specific other rate." );
+
 static int g_nCombinedAppRefreshCycleOverride[gamescope::GAMESCOPE_SCREEN_TYPE_COUNT] = { 0, 0 };
 bool g_nCombinedAppRefreshCycleChangeRefresh[gamescope::GAMESCOPE_SCREEN_TYPE_COUNT] = { true, true };
 bool g_nCombinedAppRefreshCycleChangeFPS[gamescope::GAMESCOPE_SCREEN_TYPE_COUNT] = { true, true };
@@ -983,6 +992,31 @@
 	{
 		auto rates = GetBackend()->GetCurrentConnector()->GetValidDynamicRefreshRates();
 
+		// GAMESCOPE_DYNAMIC_REFRESH_PREFER_LOWEST=1: take the lowest matching
+		// mode instead, so a 60 fps target on a 60/120 Hz panel runs the
+		// panel at 60 Hz (one frame per refresh) rather than doubling at 120.
+		static const bool s_bPreferLowest = env_to_bool( getenv( "GAMESCOPE_DYNAMIC_REFRESH_PREFER_LOWEST" ) );
+		// Steam's default per-game profile asks for the panel's highest rate (120 fps cap +
+		// refresh switching), the same request as a user picking 120. With the convar on, treat
+		// a highest-rate target as "no preference" and keep the lowest rate.
+		if ( cv_dynamic_refresh_default_lowest && rates.size() > 1 && target_fps == (int)rates[ rates.size() - 1 ] )
+		{
+			g_nDynamicRefreshRate[ type ] = rates[ 0 ];
+			return;
+		}
+
+		if ( s_bPreferLowest )
+		{
+			for ( auto rate = rates.begin(); rate != rates.end(); rate++ )
+			{
+				if (*rate % target_fps == 0)
+				{
+					g_nDynamicRefreshRate[ type ] = *rate;
+					return;
+				}
+			}
+		}
+
 		// Find highest mode to do refresh doubling with.
 		for ( auto rate = rates.rbegin(); rate != rates.rend(); rate++ )
 		{
@@ -1008,6 +1042,8 @@
