+	fprintf( stderr, "steamcompmgr: app target refresh cycle: %d fps, change_refresh=%d, change_fps_cap=%d\n",
+		override_fps, (int)change_refresh, (int)change_fps_cap );
 	update_app_target_refresh_cycle();
 }
 
