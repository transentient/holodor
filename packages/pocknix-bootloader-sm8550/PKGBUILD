# pocknix-bootloader-sm8550 — the Holodor ABL folder for SM8550 / QCS8550 boards
# (Retroid Pocket Nova / RP6, AYN Odin 2 / Mini / Portal), shipped on the SD.
#
# SM8550 boot contract (qcom-abl): the stock ABL boots only Android. We ship our
# Holodor ABL (OpenABL v1.1 built from source with Holodor splash wordmark,
# devinfo OablSettings + legacy BootMode sync, and single-DTB fallback) together
# with Android-side backup/flash/restore scripts and BootHolodor.apk under
# /usr/share/bootloader/rocknix_abl/ so build-sd-image.sh copies them onto the SD
# FAT partition (/flash/rocknix_abl/).
pkgname=pocknix-bootloader-sm8550
pkgver=1.1.9
pkgrel=5
pkgdesc="SM8550 (Retroid Pocket Nova / RP6, AYN Odin 2) Holodor ABL (OpenABL v1.1) payload + Android-side backup/flash/restore scripts and BootHolodor.apk"
arch=('any')
url="https://github.com/OpenHandheldCollective/OpenABL"
license=('GPL-2.0-only')
options=('!strip')
source=('abl_signed-SM8550.elf'
        'abl_signed-SM8550.elf.sha256'
        'backup_abl.sh'
        'flash_abl.sh'
        'restore_backup_abl.sh'
        'boot_holodor.sh'
        'BootHolodor.apk'
        'README.txt')
sha256sums=('99634bca71efa2768c1535865762b9382a2fb026472f08e83dd794ef6a727ee0'
            'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

prepare() {
  ( cd "${srcdir}" && sha256sum -c abl_signed-SM8550.elf.sha256 ) || return 1
}

package() {
  local dst="${pkgdir}/usr/share/bootloader/rocknix_abl"
  install -dm755 "${dst}"
  local f
  for f in abl_signed-SM8550.elf abl_signed-SM8550.elf.sha256 backup_abl.sh flash_abl.sh \
           restore_backup_abl.sh boot_holodor.sh BootHolodor.apk README.txt; do
    install -Dm644 "${srcdir}/${f}" "${dst}/${f}"
  done
}
