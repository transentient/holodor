# pocknix-steam — native ARM64 Steam (Big Picture under gamescope) for the Retroid Pocket 6.
# Ships the native-ARM client installer (ported from ROCKNIX "Install Steam.sh") + the gamescope
# launcher. The stock x86 steam-launcher .deb is NOT used (it pulls x86 binaries). Native ARM
# Steam is experimental (Valve publicbeta linuxarm64).
pkgname=pocknix-steam
pkgver=0.1.0
pkgrel=61   # 61 (2026-10-23): pocknix-proton-wrapper: add automatic engine-level launcher & graphics heuristics (`apply_engine_heuristics` + `apply_engine_graphics_defaults`): bypass Easy Anti-Cheat `start_protected_game.exe`, Bethesda `*Launcher.exe`, CDPR `REDprelauncher.exe` (with `os.chdir` to `bin/x64_dx12` and `ConfigVersion=7` / `LastGameVersion=500` seeding for The Witcher 3 v4.04+/v5.01), and `<Stem>_DX11.exe` selector launchers; default `VKD3D_FEATURE_LEVEL=12_1` for DirectX 12 on Adreno 6xx/8xx; export `WINE_CPU_TOPOLOGY=4:4,5,6,7` on SM8250 so Win32 `GetLogicalProcessorInformation` matches the 4 Cortex-A77 cores (`0x0F`, fixing CryEngine V / Prey SSE detection); sanitize `SteamVirtualGamepadInfo_Proton` unknown/`0x12f0` entries to Xbox 360 (`0x045e:0x028e`); disable Coherent UI GT JIT (`JSC_useJIT=false`); and seed first-launch `1280x720` Low presets across UE4/UE5, Unity (`prefs` XML, Wine registry, `Settings.json`, `graphics.cfg`, `Risk of Rain 2_Data/Config/config.cfg`), REDengine 3/4, Creation Engine, CryEngine V (`Prey/game.cfg`), Hello Games (`TKGRAPHICSSETTINGS.MXML` + FSR 2 + 4/2 threads), id Tech 7, FromSoftware, Northlight (`renderer.ini` + EULA bytes), and PlatinumGames.   # 60 (2026-10-23): pocknix-steam + pocknix-proton-wrapper: scale DXVK_CONFIG dxgi.maxDeviceMemory/maxSharedMemory by host RAM and PE header bitness (4096 MiB for 32-bit PE32 executables or <14 GB boards; 6144 MiB for 64-bit PE32+ executables on 16 GB boards; 8192 MiB on >=20 GB boards); game-fixes.json: add 377160 (Fallout 4) exe redirect Fallout4Launcher.exe -> Fallout4.exe (bypasses mouse-only launcher on gamepad handhelds).   # 59 (2026-10-22): add ConditionUser=!root to pocknix-proton-prep.service so root SSH sessions (user@0.service) do not spawn a redundant pocknix-proton-prep --watch daemon.   # 58 (2026-10-20): default DXVK_CONFIG="dxgi.maxDeviceMemory = 4096; dxgi.maxSharedMemory = 4096" in pocknix-steam and pocknix-proton-wrapper (prevents 32-bit / older D3D9/D3D10/D3D11 titles from overflowing 32-bit VRAM counters on 8-16 GiB UMA handhelds; Armada 7951896).   # 57 (2026-10-19): per-game powerProfile tweak in pocknix-proton-wrapper (applies `pocknix-power-mode --transient <mode>` on launch and restores the persisted system profile on exit).   # 56 (2026-10-12, seen on the device): pocknix-steam-bootstrap waits (<= 120 s) for timesyncd when the clock is outside 2026..2040 before its first HTTPS fetch: the RP5 booted in the year 2066 after its battery ran flat (PMIC RTC lost), every curl failed "certificate has expired" and the user saw "Steam download FAILED: could not resolve the Steam runtime version" until the supervisor retry after NTP sync (~2 min).   # 55 (2026-10-11, audit, UNTESTED on device): after pipewire-pulse answers, also wait (<= 20 s) for a default sink that is not auto_null before launching gamescope+Steam (the card arrives 15-40 s into a cold boot; a Steam that connected to Pulse with only auto_null stayed deaf for the session).   # 54 (2026-10-10, inquisitor): the pipewire-pulse wait is bounded by wall clock and `timeout 2 pactl` (a wedged server behind a listening socket blocked pactl forever = Steam never started).   # 53 (2026-10-10): wait (<=15 s) for pipewire-pulse before launching gamescope+Steam: the autologin session starts ~2 s before the user manager has pipewire-pulse up, Steam's Chromium audio service connects once and never reconnects, so a session that wins the race has no UI sounds for its whole life (RP5 first-run setup silent, nav clicks never played; measured on the mic, a Steam restart fixed it).   # 52 (2026-10-08): DOOM Eternal runs DOOMEternalx64vk.exe (its Chromium launcher never starts the game). 51 (2026-10-08): game-fixes "exe" kind; ELDEN RING runs eldenring.exe (offline) instead of the EAC launcher. 50 (2026-10-08): per-game fixes table (game-fixes.json: ini keys, args, env; POCKNIX_GAME_FIXES=0 skips): Observer UE4 HTTP off (HttpManagerThread SEH crash), DOOM 2016 +r_renderAPI 1 (GL path ~1 fps). 49 (2026-10-07): first-launch guard keyed on a seen-running marker (compatdata/pocknix-first-run-ok, written after the game's Wine process lives 20 s), not on the prefix (Steam's install-script pass creates it first); protonfixes toggle fixed (the variable's presence disables, so "on" = absent). Verified: winetricks hang killed at 150 s + prefix moved aside; Celeste untouched.   # 48 (2026-10-06): per-game "refresh120" tweak flips gamescope dynamic_refresh_default_lowest for the game's lifetime (gamescope 8).   # 47 (2026-10-06): first-launch guard (no game exe 5 min after a first launch -> kill + move the half-built prefix aside), protonfixes OFF by default (tweaks "protonfixes": true or PROTONFIXES_DISABLE in launch options override), POCKNIX_GAMESCOPE_REFRESH_DEFAULT_LOWEST -> gamescope 6.   # 46 (2026-10-05): games default to Wine's PulseAudio driver (proton-cachyos' PipeWire driver came out left/right swapped in 2 of 6 launches and silent in 3 of 6, measured on the RP5; 12 of 12 correct after); POCKNIX_GAMESCOPE_REFRESH_PREFER_LOWEST -> gamescope 0008.   # 45 (2026-10-05): POCKNIX_GAMESCOPE_REFRESH (board conf) -> gamescope -r, to run a panel on a listed lower refresh mode (RP5 Visionox: 60).   # 44 (2026-10-05): pocknix-wifi-import no longer pins the profile to interface-name=wlan0 (see bsp-common 24: after a firmware reload the netdev is wlan1 and the pinned profile makes NetworkManager cancel every iwd connection). 43: pocknix-proton-prep swaps the DXVK-2.7 donor into the downloaded Valve ARM Proton on
            #     POCKNIX_GPU_DXVK3=no boards (sm8250/a650; upstream d3b4743). 42: POCKNIX_ROTATION=shader|hw
            #     switch in the launcher (docs/rotation-experiment-2026-09-20.md)
pkgdesc="Native ARM64 Steam Big Picture (gamescope) for the RP6 — installer + launcher"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL2')
# gamescope = our ROCKNIX-patched compositor; wget/unzip/curl/tar fetch+unpack the client.
# NB: wget/unzip/curl/tar + xorg-server-xvfb are GENUINE RUNTIME deps again: pocknix-steam-bootstrap
# downloads+finalizes the client ON DEVICE on seedless images (curl/tar/unzip/xvfb), and
# pocknix-steam-install still uses wget inside the build-time bake (which runs in this same rootfs).
# seatd (gamescope seat) + pipewire (audio) come from the base image.
# gtk2 (built by us; EOL in Arch) + gdk-pixbuf2 = libs steamui.so dlopens. Two deps the native
# arm64 client needs that nothing else pulls in on a from-scratch ALARM base (Fedora/armada get
# them transitively) — found via ldd ... | grep 'not found':
#   openal   -> libopenal.so.1, a DT_NEEDED of vgui2_s.so; missing => "Could not load module
#               'bin/vgui2_s.dll'" (the .so opens but dlopen fails on the unresolved dep).
#   libcups  -> libcups.so.2, a DT_NEEDED of steamwebhelper + libcef.so (CEF always links cups
#               for print support); missing => steamwebhelper (the Big-Picture CEF UI) crash-loops.
# lsof: not a lib but a runtime tool — Steam shells out to `lsof` to find the port steamwebhelper
#   listens on for its CEF websocket (steamui<->web UI IPC); missing => "Failed to connect to
#   websocket" and gamepadui never connects.
# noto-fonts(+cjk/emoji): the gamepadui renders UI text via system fonts (fontconfig). Without CJK
#   coverage the language selector shows tofu for Chinese/Japanese/Korean (Latin works regardless).
# networkmanager: Steam's gamepadui manages Wi-Fi exclusively via the NetworkManager D-Bus API
#   (like SteamOS; ROCKNIX's steam pkg depends on it too). Without an NM backend the setup wizard
#   shows "no connections found" even when online. NB: NM must actually run + manage wlan0 (via the
#   iwd backend) — see build-sd-image.sh network plumbing, not just this dep.
# mangohud: provides the `mangoapp` overlay binary that gamescope --mangoapp spawns; this is
#   Steam's built-in performance overlay (FPS/frametime/CPU; GPU stats are limited on Adreno/msm).
#   Without it gamescope's --mangoapp has nothing to launch and the overlay never appears.
# xorg-server-xvfb provides the virtual X display used to bootstrap the client (no FEX).
# Controller uaccess: the Arch steam/game-devices-udev rules aren't in ALARM, so pocknix-bsp ships
# its own 60-pocknix-controllers.rules (the deck session needs uaccess to the gamepad hidraw nodes).
# The rest of the native client's deps resolve from the base image / the steamrt runtime.
depends=('gamescope' 'wget' 'unzip' 'curl' 'tar' 'gtk2' 'gdk-pixbuf2' 'openal' 'libcups' 'lsof'
         'noto-fonts' 'noto-fonts-cjk' 'noto-fonts-emoji' 'networkmanager' 'mangohud'
         'pocknix-steamos-shim' 'xorg-server-xvfb')
source=('pocknix-steam-install' 'pocknix-steam' 'steam' 'steam.desktop'
        'steam-256.png' 'steam-512.png' 'registry.vdf'
        'proton-toolmanifest.vdf' 'proton-compatibilitytool.vdf'
        'pocknix-proton-prep' 'pocknix-proton-prep.service'
        'pocknix-steam-seed-default-compat'
        'pocknix-proton' 'pocknix-proton-wrapper' 'fex-profiles.json' 'game-fixes.json'
        'pocknix-steam-bootstrap' 'pocknix-wifi-import' 'pocknix-wifi-import.service')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 "${srcdir}/pocknix-steam-install" "${pkgdir}/usr/bin/pocknix-steam-install"
  install -Dm755 "${srcdir}/pocknix-steam"         "${pkgdir}/usr/bin/pocknix-steam"
  # Seedless first boot: on-device client downloader (invoked by pocknix-steam/steam when the
  # client tree is missing) + the /flash/wifi.txt keyboard-free Wi-Fi importer (root oneshot,
  # enabled in build-sd-image.sh). Design: docs/steam-bootstrap-design.md.
  install -Dm755 "${srcdir}/pocknix-steam-bootstrap"    "${pkgdir}/usr/bin/pocknix-steam-bootstrap"
  install -Dm755 "${srcdir}/pocknix-wifi-import"        "${pkgdir}/usr/bin/pocknix-wifi-import"
  install -Dm644 "${srcdir}/pocknix-wifi-import.service" "${pkgdir}/usr/lib/systemd/system/pocknix-wifi-import.service"
  # Desktop-mode Steam: `/usr/bin/steam` runs the native client as a normal window (Plasma session)
  # and is the `steam` command per-game shortcuts call; steam.desktop puts it in the app grid +
  # registers the steam:// URL handler. (Game mode uses pocknix-steam/gamescope instead.)
  install -Dm755 "${srcdir}/steam"                 "${pkgdir}/usr/bin/steam"
  install -Dm644 "${srcdir}/steam.desktop"         "${pkgdir}/usr/share/applications/steam.desktop"
  # `steam` themed icon for the app grid (steam.desktop + pocknix-desktop's return-to-gamemode.desktop
  # both use Icon=steam). The native ARM client isn't a system package, so nothing else provides it.
  # Official Steam icon (Wikimedia Commons), pre-sized to the two common hicolor app sizes.
  install -Dm644 "${srcdir}/steam-256.png"         "${pkgdir}/usr/share/icons/hicolor/256x256/apps/steam.png"
  install -Dm644 "${srcdir}/steam-512.png"         "${pkgdir}/usr/share/icons/hicolor/512x512/apps/steam.png"
  # OOBE-complete registry seed (ROCKNIX resources/registry.vdf). Seeded to ~/.steam/registry.vdf
  # by the installer so the gamepadui skips the Steam Deck OOBE — whose "required update" step
  # tries to update SteamOS (which we aren't) and dead-ends with "Updater apply error: 2".
  install -Dm644 "${srcdir}/registry.vdf"          "${pkgdir}/usr/share/pocknix-steam/registry.vdf"
  # Proton-11-ARM compat-tool resources: a require_tool_appid-free toolmanifest + the custom
  # compatibilitytool.vdf. pocknix-proton-prep applies these (see below).
  install -Dm644 "${srcdir}/proton-toolmanifest.vdf"       "${pkgdir}/usr/share/pocknix-steam/proton-toolmanifest.vdf"
  install -Dm644 "${srcdir}/proton-compatibilitytool.vdf"  "${pkgdir}/usr/share/pocknix-steam/proton-compatibilitytool.vdf"
  # Registers + keeps the ARM Proton 11 compat tool usable, decoupled from Steam's own download/
  # updates, so the first in-Steam download needs NO reboot. pocknix-steam runs it at game-session
  # start; the user service (--watch) re-applies when Proton is downloaded/updated. Enabled globally
  # in build-sd-image.sh. See pocknix-proton-prep for the full rationale.
  install -Dm755 "${srcdir}/pocknix-proton-prep"           "${pkgdir}/usr/bin/pocknix-proton-prep"
  install -Dm755 "${srcdir}/pocknix-steam-seed-default-compat" "${pkgdir}/usr/bin/pocknix-steam-seed-default-compat"
  install -Dm644 "${srcdir}/pocknix-proton-prep.service"   "${pkgdir}/usr/lib/systemd/user/pocknix-proton-prep.service"
  # Per-game FEX profiles (Pocknix Control plugin writes /etc/pocknix/game-tweaks.json; the
  # wrapper applies the chosen profile via FEX_APP_CONFIG at game launch). The pocknix-proton
  # shim is the toolmanifest's commandline entrypoint; prep installs it into the tool dirs.
  install -Dm755 "${srcdir}/pocknix-proton-wrapper"        "${pkgdir}/usr/lib/pocknix/pocknix-proton-wrapper"
  install -Dm644 "${srcdir}/game-fixes.json"                "${pkgdir}/usr/share/pocknix-steam/game-fixes.json"
  install -Dm755 "${srcdir}/pocknix-proton"                "${pkgdir}/usr/share/pocknix-steam/pocknix-proton"
  install -Dm644 "${srcdir}/fex-profiles.json"             "${pkgdir}/usr/share/pocknix/fex-profiles.json"
}
