#!/bin/bash
# pocknix-desktop-firstrun — one-time Desktop Mode defaults that need the running shell.
# Launched from /etc/xdg/autostart (after plasmashell is up); idempotent via a stamp file.
#   * wallpaper: the Holodor boot-art still (pocknix-boot-art ships it for plymouth), applied with
#     Plasma's own tool so the user can change it afterwards like any wallpaper.
set -u
STATE="${XDG_STATE_HOME:-${HOME}/.local/state}"; mkdir -p "${STATE}"
WALL="${POCKNIX_DESKTOP_WALLPAPER:-/usr/share/plymouth/themes/holodor/frame-01.png}"
if [ ! -e "${STATE}/pocknix-wallpaper-applied" ] && [ -r "${WALL}" ] && command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
  for _ in $(seq 1 30); do   # plasmashell registers on D-Bus a moment after autostart fires
    if plasma-apply-wallpaperimage "${WALL}" >/dev/null 2>&1; then touch "${STATE}/pocknix-wallpaper-applied"; break; fi
    sleep 1
  done
fi
#   * keyboard button: pin the on-screen keyboard launcher (pocknix-osk) to the panel's task manager,
#     through plasmashell's own scripting interface. Once; a user who removes it keeps it removed.
if [ ! -e "${STATE}/pocknix-osk-launcher-added" ] && [ -e /usr/share/applications/pocknix-osk.desktop ] \
   && command -v qdbus6 >/dev/null 2>&1; then
  JS='var ps = panels();
for (var i = 0; i < ps.length; i++) {
    var ws = ps[i].widgets();
    for (var j = 0; j < ws.length; j++) {
        var w = ws[j];
        if (w.type != "org.kde.plasma.icontasks" && w.type != "org.kde.plasma.taskmanager") continue;
        w.currentConfigGroup = ["General"];
        var arr = String(w.readConfig("launchers", "")).split(",").filter(function (s) {
            return s.length > 0 && s.indexOf("pocknix-osk.desktop") < 0;
        });
        if (arr.length == 0) {
            arr = ["applications:systemsettings.desktop", "applications:org.kde.discover.desktop", "preferred://filemanager"];
        }
        arr.push("applications:pocknix-osk.desktop");
        w.writeConfig("launchers", arr);
        w.reloadConfig();
        print("pinned");
    }
}'
  for _ in $(seq 1 30); do
    if qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "${JS}" 2>/dev/null | grep -q pinned; then
      touch "${STATE}/pocknix-osk-launcher-added"; break
    fi
    sleep 1
  done
fi
exit 0
