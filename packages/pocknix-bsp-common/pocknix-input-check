#!/bin/bash
# pocknix-input-check — verify InputPlumber built the controller we expect (boot-time, root).
# RC 20260927 booted with TWO composite devices (upstream's 50-ayn_odin3.yaml took the gamepad
# with an Xbox mapping) and nothing said so until a human pressed A. Expectation on Holodor
# handhelds: one primary gamepad CompositeDevice ([holodor] on SM8750, or Retroid Pocket
# Controller on SM8250) with target deck-uhid. Anything else -> warning in the journal (tag
# pocknix-input-check) and /run/pocknix/input-check for pocknix-diag / Pocknix Control.
# Read-only; never restarts anything.
set -u
OUT=/run/pocknix/input-check; mkdir -p /run/pocknix
BUS=org.shadowblip.InputPlumber; IFACE=org.shadowblip.Input.CompositeDevice
report() {
  printf '%s\n' "$1" > "$OUT.tmp" && mv -f "$OUT.tmp" "$OUT"
  logger -t pocknix-input-check -p "${2:-daemon.warning}" -- "$1"
}
paths=$(timeout 5 busctl tree "$BUS" 2>/dev/null | grep -o '/org/shadowblip/InputPlumber/CompositeDevice[0-9]*' | sort -u)
[ -n "$paths" ] || { report "no InputPlumber composite device (inputplumber not running or nothing matched)"; exit 0; }
n=$(printf '%s\n' "$paths" | wc -l)
expected_sources=$(grep -l -E 'rsinput-gamepad|retroid|gpio-keys' /sys/class/input/event*/device/phys /sys/class/input/event*/device/name 2>/dev/null | sed 's|/device/.*||' | sort -u | wc -l)
summary=""; ours=0; ours_sources=0; ours_target=""
for p in $paths; do
  name=$(timeout 5 busctl get-property "$BUS" "$p" "$IFACE" Name 2>/dev/null | sed 's/^s "//; s/"$//')
  srcs=$(timeout 5 busctl get-property "$BUS" "$p" "$IFACE" SourceDevicePaths 2>/dev/null | awk '{print $2}')
  tgts=$(timeout 5 busctl get-property "$BUS" "$p" "$IFACE" TargetDevices 2>/dev/null | grep -o 'target/[a-z0-9_-]*' | tr '\n' ' ')
  summary+="${p##*/}: \"$name\" sources=$srcs targets=[$tgts]; "
  case "$name" in
    *"[holodor]"*|*"Retroid Pocket"*)
      ours=$((ours+1)); ours_sources=${srcs:-0}; ours_target=$tgts ;;
  esac
done
if [ "$ours" -ge 1 ] && [ "${ours_sources:-0}" -ge 1 ]; then
  report "ok: $n composite device(s), primary sources=$ours_sources/$expected_sources, targets [$ours_target]" daemon.info
else
  report "UNEXPECTED controller layout ($n composite devices, ours=$ours with $ours_sources/$expected_sources sources): $summary"
fi
exit 0
