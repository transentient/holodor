#!/usr/bin/python3
# pocknix-boot-target — Read and switch the ROCKNIX ABL boot target (Holodor <-> Android).
#
# How ROCKNIX ABL stores its boot mode (verified by disassembling LinuxLoader.efi in
# abl_signed-SM8750.elf and abl_signed-SM8250.elf, plus the live Odin 3 devinfo dump):
#   - Partition: /dev/disk/by-partlabel/devinfo (4096 bytes; magic "ANDROID-BOOT!" at offset 0).
#   - Persistent value table: 8 slots starting at offset 0x998 (2456), each 0x5e (94) bytes:
#       uint16_t in_use      (1 = active, 0 = free)
#       uint16_t name_size   (length of name string)
#       uint16_t value_size  (length of value bytes)
#       char     name[56]    (ASCII key name, zero-padded)
#       uint8_t  value[32]   (raw value bytes)
#   - Keys managed by ROCKNIX ABL:
#       "RocknixAblVer"  -> e.g. b"1.1.8\x00" (proves ROCKNIX ABL is installed & initialized)
#       "BootMode"       -> 1 byte: 0x00 = Linux (Holodor), 0x01 = Android
#       "BootSourceMode" -> 1 byte: 0 = Auto, 1 = SD, 2 = USB, 3 = Internal (or per-ABL version)
#       "ModelSelection" -> e.g. b"AYN Odin 3\x00"
#       "AltVolumeUp"    -> 1 byte: 0x00 or 0x01
#   - There is NO whole-partition CRC/hash over devinfo; WritePersistentValue (0x3edbc in
#     LinuxLoader.efi) updates the slot in-place and writes the primeros 0xcc8 (3272) bytes.
#
# Safety guard:
#   We ONLY allow writing "BootMode" if:
#     1. The devinfo partition starts with b"ANDROID-BOOT!" AND
#     2. The "RocknixAblVer" persistent value is present in the slot table.
#   On devices booting from an SD card via stock ABL's UEFI "Ubuntu (SD Card)" toggle without
#   ROCKNIX ABL installed, "RocknixAblVer" is absent and this tool reports supported=false.
import json
import os
import struct
import subprocess
import sys

DEVINFO_MAGIC = b"ANDROID-BOOT!"
TABLE_OFFSET = 0x998
SLOT_COUNT = 8
SLOT_FMT = "<HHH56s32s"
SLOT_SIZE = struct.calcsize(SLOT_FMT)  # 94 (0x5e)


def find_devinfo_path() -> str:
    override = os.environ.get("POCKNIX_DEVINFO_PATH")
    if override:
        return override
    for candidate in (
        "/dev/disk/by-partlabel/devinfo",
        "/dev/disk/by-partlabel/devinfo_a",
        "/dev/block/by-name/devinfo",
    ):
        if os.path.exists(candidate):
            return candidate
    return "/dev/disk/by-partlabel/devinfo"


def has_android_partitions() -> bool:
    if os.environ.get("POCKNIX_DEVINFO_PATH"):
        return True
    for p in (
        "/dev/disk/by-partlabel/boot_a",
        "/dev/disk/by-partlabel/super",
        "/dev/block/by-name/boot_a",
    ):
        if os.path.exists(p):
            return True
    return False


def read_slots(data: bytes) -> dict[str, tuple[int, bytes]]:
    out = {}
    for i in range(SLOT_COUNT):
        off = TABLE_OFFSET + i * SLOT_SIZE
        if off + SLOT_SIZE > len(data):
            break
        in_use, name_sz, val_sz, raw_name, raw_val = struct.unpack_from(SLOT_FMT, data, off)
        if in_use != 1 or name_sz == 0 or name_sz > 56 or val_sz > 32:
            continue
        name = raw_name[:name_sz].rstrip(b"\x00").decode("ascii", "replace")
        val = raw_val[:val_sz]
        out[name] = (i, val)
    return out


def write_slot(buf: bytearray, key: str, val: bytes) -> None:
    key_bytes = key.encode("ascii")
    if len(key_bytes) > 56 or len(val) > 32:
        raise ValueError("key/value exceeds devinfo slot capacity")

    slots = read_slots(buf)
    if key in slots:
        idx = slots[key][0]
    else:
        idx = -1
        for i in range(SLOT_COUNT):
            off = TABLE_OFFSET + i * SLOT_SIZE
            in_use = struct.unpack_from("<H", buf, off)[0]
            if in_use != 1:
                idx = i
                break
        if idx < 0:
            raise RuntimeError("no free persistent-value slot in devinfo")

    off = TABLE_OFFSET + idx * SLOT_SIZE
    # Preserve existing bytes in the value buffer if updating in place, just like ABL's CopyMem
    _, _, _, _, old_val = struct.unpack_from(SLOT_FMT, buf, off)
    new_name = key_bytes.ljust(56, b"\x00")
    new_val = bytearray(old_val if key in slots else b"\x00" * 32)
    new_val[: len(val)] = val
    struct.pack_into(SLOT_FMT, buf, off, 1, len(key_bytes), len(val), new_name, bytes(new_val))


def get_status(path: str) -> dict:
    if not os.path.exists(path):
        return {"ok": True, "supported": False, "reason": f"{path} not found"}
    try:
        with open(path, "rb") as f:
            data = f.read(4096)
    except OSError as e:
        return {"ok": False, "supported": False, "reason": str(e)}

    if len(data) < TABLE_OFFSET + SLOT_COUNT * SLOT_SIZE or not data.startswith(DEVINFO_MAGIC):
        return {"ok": True, "supported": False, "reason": "devinfo magic mismatch"}

    slots = read_slots(data)
    ver_key = next(
        (k for k in ("HolodorAblVer", "OpenAblVer", "RocknixAblVer") if k in slots),
        None,
    )
    has_oabl = "OablSettings" in slots and len(slots["OablSettings"][1]) >= 14 and slots["OablSettings"][1][0] >= 1
    if not ver_key and not has_oabl:
        return {
            "ok": True,
            "supported": False,
            "reason": "Holodor/OpenABL/ROCKNIX ABL not detected in devinfo (booting via stock ABL / SD EFI)",
        }
    if not has_android_partitions():
        return {"ok": True, "supported": False, "reason": "Android partitions not present"}

    if ver_key:
        abl_ver = slots[ver_key][1].rstrip(b"\x00").decode("ascii", "replace")
    else:
        abl_ver = f"OpenABL (schema {slots['OablSettings'][1][1]})"

    if has_oabl:
        oabl_val = slots["OablSettings"][1]
        bits = struct.unpack_from("<Q", oabl_val, 2)[0]
        bm_code = bits & 0x3
        # Code 0 = unset (Linux), 1 = 0+1 (Linux), 2 = 1+1 (Android)
        boot_mode_byte = 1 if bm_code == 2 else 0
        # If legacy BootMode slot is also present and was set by an external tool, honor it
        if "BootMode" in slots and slots["BootMode"][1]:
            boot_mode_byte = slots["BootMode"][1][0]
        src_code = (bits >> 16) & 0x7
        boot_src_byte = (src_code - 1) if src_code > 0 else 0
        model_parts = []
        for mk in ("OablModel0", "OablModel1", "OablModel2"):
            if mk in slots:
                model_parts.append(slots[mk][1])
        model = b"".join(model_parts).rstrip(b"\x00").decode("utf-8", "replace")
        if not model and "ModelSelection" in slots:
            model = slots["ModelSelection"][1].rstrip(b"\x00").decode("ascii", "replace")
    else:
        model = (
            slots["ModelSelection"][1].rstrip(b"\x00").decode("ascii", "replace")
            if "ModelSelection" in slots
            else ""
        )
        boot_mode_byte = slots["BootMode"][1][0] if ("BootMode" in slots and slots["BootMode"][1]) else 0
        boot_src_byte = (
            slots["BootSourceMode"][1][0]
            if ("BootSourceMode" in slots and slots["BootSourceMode"][1])
            else 0
        )
    return {
        "ok": True,
        "supported": True,
        "ablVersion": abl_ver,
        "model": model,
        "bootMode": "android" if boot_mode_byte != 0 else "linux",
        "bootSourceMode": boot_src_byte,
    }


def set_boot_mode(path: str, android: bool) -> dict:
    st = get_status(path)
    if not st.get("supported"):
        return {
            "ok": False,
            "error": st.get("reason", "ABL boot switching not supported on this device"),
        }
    try:
        with open(path, "r+b") as f:
            buf = bytearray(f.read(4096))
            slots = read_slots(buf)
            if "OablSettings" in slots and len(slots["OablSettings"][1]) >= 14 and slots["OablSettings"][1][0] >= 1:
                oabl_val = bytearray(slots["OablSettings"][1].ljust(32, b"\x00"))
                bits = struct.unpack_from("<Q", oabl_val, 2)[0]
                bits = (bits & ~0x3) | (2 if android else 1)
                struct.pack_into("<Q", oabl_val, 2, bits)
                write_slot(buf, "OablSettings", bytes(oabl_val))
                if "BootMode" in slots:
                    write_slot(buf, "BootMode", b"\x01" if android else b"\x00")
            else:
                write_slot(buf, "BootMode", b"\x01" if android else b"\x00")
            f.seek(0)
            f.write(buf)
            f.flush()
            os.fsync(f.fileno())
    except Exception as e:
        return {"ok": False, "error": str(e)}
    return get_status(path)


def main() -> int:
    if os.geteuid() != 0 and not os.environ.get("POCKNIX_DEVINFO_PATH"):
        os.execvp("/usr/bin/pkexec", ["/usr/bin/pkexec", "/usr/local/bin/pocknix-boot-target"] + sys.argv[1:])

    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    path = find_devinfo_path()

    if cmd == "status":
        st = get_status(path)
        print(json.dumps(st))
        return 0 if st.get("ok") else 1
    elif cmd == "set-android":
        res = set_boot_mode(path, True)
        print(json.dumps(res))
        return 0 if res.get("ok") else 1
    elif cmd == "set-linux":
        res = set_boot_mode(path, False)
        print(json.dumps(res))
        return 0 if res.get("ok") else 1
    elif cmd == "reboot-android":
        res = set_boot_mode(path, True)
        print(json.dumps(res))
        if not res.get("ok"):
            return 1
        if not os.environ.get("POCKNIX_NO_REBOOT"):
            subprocess.run(["/usr/bin/systemctl", "reboot"], check=False)
        return 0
    else:
        print("usage: pocknix-boot-target {status|set-android|set-linux|reboot-android}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
