post_install() { _enable; }
post_upgrade() { _enable; }
_enable() {
  if [ -d /usr/lib/pocknix/overlay-sync/bin ]; then
    install -d /usr/local/bin
    for f in /usr/lib/pocknix/overlay-sync/bin/*; do
      [ -f "$f" ] || continue
      install -m755 "$f" "/usr/local/bin/$(basename "$f").tmp" && \
        mv -f "/usr/local/bin/$(basename "$f").tmp" "/usr/local/bin/$(basename "$f")" || true
    done
  fi
  if [ -d /usr/lib/pocknix/overlay-sync/systemd ]; then
    install -d /etc/systemd/system
    for f in /usr/lib/pocknix/overlay-sync/systemd/*; do
      [ -f "$f" ] || continue
      install -m644 "$f" "/etc/systemd/system/$(basename "$f").tmp" && \
        mv -f "/etc/systemd/system/$(basename "$f").tmp" "/etc/systemd/system/$(basename "$f")" || true
    done
  fi
  if [ -d /usr/lib/pocknix/overlay-sync/hooks ]; then
    install -d /etc/pacman.d/hooks
    for f in /usr/lib/pocknix/overlay-sync/hooks/*; do
      [ -f "$f" ] || continue
      install -m644 "$f" "/etc/pacman.d/hooks/$(basename "$f").tmp" && \
        mv -f "/etc/pacman.d/hooks/$(basename "$f").tmp" "/etc/pacman.d/hooks/$(basename "$f")" || true
    done
  fi
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable pocknix-input-check.service >/dev/null 2>&1 || true
  # enable + (re)start: an OTA should pin the next game launched, without a reboot
  systemctl enable pocknix-game-affinity.service >/dev/null 2>&1 || true
  systemctl disable pocknix-wifi-heal-boot.service >/dev/null 2>&1 || true   # the <= 35 boot ladder
  systemctl enable pocknix-wifi-heal.service >/dev/null 2>&1 || true
  systemctl restart pocknix-wifi-heal.service >/dev/null 2>&1 || true
  systemctl restart pocknix-game-affinity.service >/dev/null 2>&1 || true
  systemctl restart pocknix-volumed.service >/dev/null 2>&1 || true
  systemctl restart pocknix-powerd.service >/dev/null 2>&1 || true
  systemctl restart pocknix-fancontrol.service >/dev/null 2>&1 || true
}
