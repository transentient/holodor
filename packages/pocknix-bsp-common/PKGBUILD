# pocknix-bsp-common — the device-NEUTRAL board-support mechanics shared by every
# pocknix device: the sleep.d dispatcher + suspend hooks, the handheld power-key
# policy, and the session udev rules. Device-specific quirks (input maps, audio
# UCM, SoC suspend/cpuidle tweaks, device.conf) live in each device's BSP under
# devices/<name>/packages/pocknix-bsp-<name>, which depends on this package.
pkgname=pocknix-bsp-common
pkgver=0.1.0
pkgrel=43   # 43 (2026-10-23): pocknix-game-affinity: replace $(cat "${t}/comm") subshell forks with shell builtin `read -r comm < "${t}/comm"` (eliminates ~500 forks/tick burning 12.5% of a core during gameplay), re-pin descendant game processes every 6 s when Wine/Win32 SetProcessAffinityMask(0xFF) resets Cpus_allowed_list to 0-7 on big.LITTLE SoCs (RP5 Dark Souls Remastered: process CPU 215% -> 125%, max frame spike 109.4 ms -> 41.0 ms; Cuphead: 58.9 -> 60.0 FPS, 13x fewer spikes), skip Install=1/iscriptevaluator.exe reapers, heal stale GAMESCOPECTRL_BASELAYER_APPID="413091, 769, <appid>" and clear stale STEAM_INPUT_FOCUS=1 on Steam's 769 window (cached in last_win769) when a game window maps, and keep running in PIN_CPUS=0 mode on all-fast-core SoCs (SM8750) to clamp GAMESCOPE_FPS_LIMIT to POCKNIX_PANEL_REFRESH when POCKNIX_GAMESCOPE_REFRESH_DEFAULT_LOWEST=1; pocknix-power-mode: separate balanced (CPU 80% / GPU 82%, schedutil) from performance (CPU 100% / GPU 100%, schedutil) and max (CPU 100% / GPU 100%, performance governor + GPU min=max). / 42 (2026-10-22): pocknix-charge-full: do not write constant_charge_current when battery status is Full (prevents udev loop if hardware charger reports 0 uA charge current at 100% SoC); pocknix-wifi-heal: add third ground-truth recovery case for ath12k `dp_tx: failed to find the peer with peer_id 0` on post-wake BSSID roam (Odin 3 2026-10-22 20:29:03: waits 5 s for gateway ping, then cycles wifi radio and brings profile up so NM does not time out DHCP and leave wlan0 disconnected with iwd AutoConnect disabled). / 41 (2026-10-19): pocknix-boot-target supports both OpenABL v1.1 (SettingsStorePack 'ROCKNIX\0\0' at devinfo+0x990) and ROCKNIX ABL (BootMode at offset+56) plus HolodorAblVer/OpenAblVer/RocknixAblVer. / 40 (2026-10-19): de-fragilify & OTA-sync pass: ship overlay daemons/units (pocknix-powerd, pocknix-fancontrol, pocknix-fan-mode, pocknix-lavd-mode, pocknix-fex-binfmt, pocknix-gamescope-rt, pocknix-volumed, pocknix-diag, pocknix-update) via /usr/lib/pocknix/overlay-sync/ so pacman -Syu updates them without unowned-file conflicts; bound all nmcli/busctl/sleep.d hook subprocesses with timeouts; persist wifi-sleep-off in /var/lib/pocknix across hard resets; dynamic battery & big-CPU discovery in pocknix-telemetryd; honor /var/lib/pocknix/charge-limit and /var/lib/pocknix/bypass-charging in pocknix-charge-full and pocknix-telemetryd; support SM8250 controller check in pocknix-input-check; atomic state writes across mode helpers. / 39 (2026-10-19): add pocknix-boot-target (/usr/local/bin/pocknix-boot-target) to read/switch ROCKNIX ABL BootMode (Holodor <-> Android) in /dev/disk/by-partlabel/devinfo without holding Vol- at boot. / 38 (2026-10-17): the cpuidle-state1 sleep hooks save cpu0 state1 'disable' before suspend and restore THAT value after resume instead of forcing 1 (commit ebebb82 of 10-16 was committed without a pkgrel; the forced 1 left the RP5's cpu0 without its power-collapse state while awake after the first sleep, confirmed 10-17 after an 11.7 h sleep on bsp-common 37: disable=1, 30-pocknix-cpuidle.conf sets it only on the SM8550). / 37 (2026-10-15 23:xx + 10-16 00:30): Steam UI on the fast cores (pocknix-game-affinity also pins steamwebhelper: Steam's own 0x7c mask put the CEF threads on the A55s, library grid "slides then snaps"; Cliff's eye A/B) + GPU clock floor per board (pocknix-power-mode honours POCKNIX_GPU_MIN_FREQ in balanced/performance; RP5 490 MHz); second verified wifi case in pocknix-wifi-heal: launched by sleep.d/post/000-wifi as a transient unit (`pocknix-wifi-heal --after-resume`; a /dev/kmsg line is not seen by journalctl -k here), once NM says connected, ping the gateway x3; silent -> ONE nmcli connection up (RP5 23:2x: long sleep -> fast re-assoc with the same AID -> router answers ARP but drops IP; the reconnect cured it in 5 s); a flag disables it when a reconnect does not help (ICMP-less routers); test knob /run/pocknix-wifi-heal-test-gw. / 36 (2026-10-15, TESTED 12:09 on the RP5 with injected recovery lines: connected = no action; disconnected = PCIe power cycle + reconnect in 13 s, netdev renamed wlan1 as expected): wifi heal reduced to the one verified case, event-driven (pocknix-wifi-heal.service follows the kernel log; chip power cycle only after a firmware recovery that leaves the link down); boot unit, NM dispatcher hook and 60 s connectivity interval removed; 000-wifi post hook no longer launches a heal. / 35 (2026-10-14, TESTED at runtime 23:46): /usr/lib/sysctl.d/55-pocknix-multihome.conf: net.ipv4.conf.{all,default}.arp_ignore=1 + arp_announce=2. ROOT CAUSE of the wlan0 /24 route loss when the dock's ethernet is attached: the dock NIC answers ARP for the wifi address (Linux default arp_ignore=0), NetworkManager's address-conflict detection on wlan0 ("conflict detected for IP address 192.168.1.68 with host <dock NIC MAC>") withdraws the wifi subnet route; unplug the dock and the device has a default route only. With the knobs a software undock/redock of the dock NIC (usb unbind/bind) keeps the route and logs no conflict.   # 34 (2026-10-14, UNTESTED): 003-sdam-debug finds the PM8150 SDAM nvmem by its device-tree node (nvram@b100) through /usr/lib/pocknix/sdam-debug-lib instead of the hardcoded spmi_sdam0: nvmem ids share one counter across all nvmem devices, the SDAM was spmi_sdam1 on kernel 26 and every sleep logged "SDAM write failed" (overnight row 10-14). Still owed from the same row: the wlan0 /24 connected route after the dock's ethernet leaves (needs a hands-free repro: unbind the dock NIC while watching ip monitor), ethernet back at USB 2 after a docked wake.   # 33 (2026-10-11, UNTESTED): pocknix-wifi-heal is healthy when the default gateway answers a ping (or NM says full), not only when NM's internet check (HTTP to ping.archlinux.org) says full: a WAN outage or a slow check host no longer walks every boot/wake down the ladder; the PCIe reset (firmware reload, the step that renamed the netdev on 10-05) runs only when the wifi device is gone or NM reports it unavailable with the radio on, never on a device that is alive but not connected (no AP, refused, router silent); no wifi profile = nothing to heal; the chip is found by driver (ath11k_pci/ath12k_pci) when the netdev is gone. pocknix-wifi-heal-boot.service is Type=exec: as a oneshot it held multi-user.target (a target is After= everything it Wants) and every After=multi-user.target unit (power mode, game affinity, fan control, diag) for the whole ladder (~2.5 min) on a boot without network.   # 32 (2026-10-11, UNTESTED): 010-usb-host pre waits for the dwc3 `mode` readback to say device (up to 5 s, logs the time it took) instead of a fixed 1 s sleep: the role switch is a kernel work item (xhci removal + core soft reset) and the suspend must not race it.   # 31 (2026-10-11, UNTESTED): sleep.d 010-usb-host pre/post - before suspend the dwc3 controller leaves host mode when a USB device is attached (dock/hub) and re-enters it after resume: the host no longer sleeps with an active device, which is what produced 'HS-PHY not in L2' + 'xhci Host System Error' + a dead hub/Type-C port until reboot (RP5 10-10, Odin 09-07). 30 (2026-10-11): 20-pocknix-powerkey.conf HandlePowerKeyLongPress=ignore - the 5 s hold-to-poweroff moves into pocknix-powerd (overlay), which verifies the key against the PMIC PON_RT_STS register before powering off; RP5 10-10 20:12: docked idle sleep, self-wake, phantom 5 s KEY_POWER, logind powered the device off with nobody near it. 29 (2026-10-08): 40-pocknix-quantum.conf floors the PipeWire quantum at 256 (a Source-engine game pulled the graph to 128 frames and the speakers distorted; clean at 1024 by ear). 28 (2026-10-08): mask systemd-gpt-auto-generator (orphaned /efi autofs after daemon-reload broke sandboxed service starts: "/efi: Host is down"). 27 (2026-10-08): NM dispatcher hook (90-pocknix-wifi-heal) runs the heal on every connectivity-change to LIMITED/PORTAL, NM re-checks every 60 s (30-pocknix-connectivity.conf). RP5 cold boot 10-08: the boot heal passed at 15 s, the router stopped answering this client's IP traffic at ~5 min (ARP + every other LAN host fine), `nmcli connection up` fixed it at once.   # 26 (2026-10-07): wifi-heal treats NM "limited" as unhealthy and runs once at boot (pocknix-wifi-heal-boot.service): cold boot came up with LAN but no internet.   # 25 (2026-10-06): pocknix-game-affinity moves dxvk-shader-* threads to all cores every 5 s (they inherited the big-core pin and competed with the render thread).   # 24 (2026-10-05): NEW pocknix-game-affinity.service - pins every Steam-launched game to the fast cores on big.LITTLE SoCs (RP5: 34-44 fps with 5 % of frames over 15-18 ms, measured with gamescope frame timings inside one run; no-op on the Odin 3). ALSO: pocknix-wifi-heal finds the wifi netdev by type (not wlan0), waits ~1 min before touching anything and ~2 min before the PCIe reset, and re-activates the profile after the reset. RP5 10-03..05: a first-association refusal after a 14 h sleep was escalated into a PCIe reset within 45 s; the chip came back as wlan1, the wlan0-pinned profile could never match again, wifi stayed dead after every wake until a reboot. 23 (2026-09-27): pocknix-input-check (boot-time InputPlumber layout self-check, journal tag pocknix-input-check + /run/pocknix/input-check); .install enables it. 22: WP2 resume dead-controls (2026-09-24): READ-ONLY post-resume forensics
            #     (sleep.d/post/090-input-forensics -> journalctl -t pocknix-input-forensics),
            #     pocknix-resume-recover (manual H1/H2/H3/H4 ladder, never auto-run), and the
            #     InputPlumber #732 udev workaround 99-pocknix-inputplumber-target.rules (belt;
            #     braces = inputplumber 0.81.0).
            # 21: 60-pocknix-usb-autosuspend.rules — runtime-suspend ONLY the dwc3-qcom glue (drops its
            #     1 GB/s USB-to-DDR interconnect vote while the port is idle), leaf USB devices/hubs
            #     stay powered (ArmadaOS 98d8f53, 2026-09-15; upstream sweep 2026-09-20 item U1).
            # 20: download-inhibit policy file (always|plugged|never, Pocknix Control switch) + no hold at <=5% on battery. 19: power-mode: `max` no longer survives a reboot (boot re-apply turns it into balanced). 18: wake-grace-post: `$i` not `${i}` in the error line (systemd expanded `${i}` inside the sh -c string, cosmetic warning every wake). 17: wake-grace retries the inhibit (logind race = 2-presses-to-wake); wifi-heal launched as a
            #     transient unit (setsid& died with the hook cgroup, never ran) + nmcli connection-up first;
            #     charge-full re-applied on USB power_supply udev events; 16: download-inhibit + wake-grace
pkgdesc="pocknix shared board support: sleep.d dispatcher, suspend hooks, power-key policy, session udev rules"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL2')
install=pocknix-bsp-common.install
depends=('gptfdisk')
source=('pocknix-sleep' 'sdam-debug-pre' 'sdam-debug-post' 'sdam-debug-lib'
        'wifi-sleep-pre' 'wifi-sleep-post'
        'pocknix-telemetryd' 'pocknix-telemetry.service'
        'pocknix-power-mode' 'pocknix-power-mode.service'
        'pocknix-wifi-heal' 'pocknix-wifi-heal.service' '40-pocknix-quantum.conf'
        'pocknix-slot-successful' 'pocknix-slot-successful.service'
        'pocknix-charge-full' 'pocknix-charge-full.service' '70-pocknix-charge-full.rules'
        'leds-sleep-pre' 'leds-sleep-post'
        'cpuidle-state1-sleep-pre' 'cpuidle-state1-sleep-post'
        'pocknix-download-inhibit' 'pocknix-download-inhibit.service' 'wake-grace-post'
        'usb-host-sleep-pre' 'usb-host-sleep-post'
        'iwd-wait-wlan0.conf'
        '20-pocknix-powerkey.conf' 'no-freeze-user-sessions.conf'
        '90-pocknix-backlight.rules' '60-pocknix-controllers.rules'
        '60-pocknix-usb-autosuspend.rules'
        'input-forensics-post' 'pocknix-input-forensics' 'pocknix-resume-recover'
        '99-pocknix-inputplumber-target.rules'
        'pocknix-input-check' 'pocknix-input-check.service'
        'pocknix-game-affinity' 'pocknix-game-affinity.service'
        '55-pocknix-multihome.conf'
        'pocknix-boot-target'
        'pocknix-powerd' 'pocknix-powerd.service'
        'pocknix-fancontrol' 'pocknix-fancontrol.service' 'pocknix-fan-mode'
        'pocknix-lavd-mode' 'pocknix-lavd.service'
        'pocknix-fex-binfmt' 'pocknix-fex-binfmt.service' '90-pocknix-fex-binfmt.hook'
