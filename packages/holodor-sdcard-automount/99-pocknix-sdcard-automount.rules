# pocknix SD-card automount — mirror of SteamOS's hwsupport automount rule, extended for Android
# exFAT/FAT32 portable-storage ROM cards.
#
# On insertion of an ext4, exfat, or vfat filesystem on the microSD slot (mmcblk*), hand the device
# to sdcard-mount.sh:
#   - ext4 cards are mounted under /run/media/deck with the SteamOS<->pocknix uid idmap and
#     registered with the running Steam client (steam://addlibraryfolder) for Proton/Steam storage.
#   - exfat/vfat (and ext4) cards are scanned by pocknix-sdcard-roms-sync so shared Android/Holodor
#     ROMs, BIOS files, and ES-DE media/favorites under ~/Emulation work plug-and-play.
#
# Matching ENV{ID_FS_USAGE}=="filesystem" with KERNEL=="mmcblk[0-9]*" covers both standard
# partitioned cards (mmcblk0p1) and unpartitioned "superfloppy" exFAT cards (mmcblk0).
ACTION=="add",    SUBSYSTEM=="block", KERNEL=="mmcblk[0-9]*", ENV{ID_FS_USAGE}=="filesystem", ENV{ID_FS_TYPE}=="ext4|exfat|vfat", RUN{program}+="/usr/bin/systemd-run --no-block /usr/lib/hwsupport/sdcard-mount.sh add %k"
ACTION=="remove", SUBSYSTEM=="block", KERNEL=="mmcblk[0-9]*", RUN{program}+="/usr/bin/systemd-run --no-block /usr/lib/hwsupport/sdcard-mount.sh remove %k"
