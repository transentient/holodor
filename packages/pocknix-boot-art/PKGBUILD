# pocknix-boot-art — the Holodor boot splash: ssalmon_px's commissioned
# pixel-art cutscene as a plymouth `script` theme (selected by overlay
# /etc/plymouth/plymouthd.conf).
#
# Source of truth for the art is assets/boot-cutscene/ in the repo (aseprite
# originals + delivery GIFs). The frames/ PNGs here are DERIVED — regenerate
# from the repo root with:
#   ffmpeg -i "assets/boot-cutscene/GIFs/HOLODOR Intro_10FPS.gif" \
#     -vf "scale=240:135:flags=neighbor,scale=1920:1080:flags=neighbor" \
#     -frames:v 34 packages/pocknix-boot-art/frame-%02d.png
# (frames live flat next to the PKGBUILD — makepkg local sources don't
# resolve from subdirectories.)
# 240x135 is the art's native canvas (the 720x405 GIF is an exact 3x, so the
# down/up round-trip is lossless); 8x nearest-neighbor = crisp 1920x1080.
# Frames 35-40 are the fade-to-black tail, dropped on purpose — the theme
# holds the logo and plymouth's quit transition does the fade.
pkgname=pocknix-boot-art
pkgver=1.0.0
pkgrel=2  # 2: preload all frames before playback (no stutter from SD); previous: lazy frames
pkgdesc="Holodor plymouth boot theme (pixel-art cutscene by ssalmon_px)"
arch=('any')
url="https://github.com/transentient/holodor"
license=('custom')   # commissioned art; originals in repo assets/boot-cutscene
depends=('plymouth')
source=('holodor.plymouth' 'holodor.script')
sha256sums=('SKIP' 'SKIP')
for _f in $(seq -w 1 34); do
  source+=("frame-${_f}.png")
  sha256sums+=('SKIP')
done

package() {
  local t="${pkgdir}/usr/share/plymouth/themes/holodor"
  install -Dm644 "${srcdir}/holodor.plymouth" "${t}/holodor.plymouth"
  install -Dm644 "${srcdir}/holodor.script"   "${t}/holodor.script"
  local f
  for f in "${srcdir}"/frame-*.png; do
    install -Dm644 "${f}" "${t}/${f##*/}"
  done
}
