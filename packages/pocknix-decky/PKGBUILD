# pocknix-decky — Decky Loader (QAM plugin framework) service integration + the Pocknix
# Control plugin. Modeled on armada's decky install (45-install-decky-plugins.sh +
# armada-decky-sync). The loader itself is the decky-loader package: upstream v3.2.9 built
# from source on Holo Core's native python (pkgrel <= 18 ran upstream's x86_64 PyInstaller
# bundle under FEX in a private binfmt namespace; that whole apparatus is gone, and so is
# Decky's self-updater — pacman owns the loader).
#
# pocknix-decky-sync.service seeds deck's ~/homebrew at boot and re-copies the
# PocknixControl plugin (OS-owned system UI: fan curve / scx_lavd mode / per-game FEX profile).
# The plugin frontend (dist/index.js) is prebuilt and committed — no node at package build time.
pkgname=pocknix-decky
pkgver=0.1.0
pkgrel=20  # 20 (2026-09-27): STICKS section: Zero/Reset stick centres (pocknix-input-calibration; per-unit rsinput centre offsets). 19: native decky-loader package (no FEX, no binfmt namespace, no x86 seeding); updater owned by pacman. 18: loader unit waits for Steam + Nice 10 (boot-time CPU to Steam). 17: DOWNLOADS section: stay-awake-for-downloads switch (always/plugged/never). 16: custom fan curves: FAN section with live graph + readout, fullscreen curve editor (touch drag / d-pad), user curves in /etc/pocknix/fan-curves, dynamic curve list. 15: Stick LEDs section
pkgdesc="Decky Loader service integration + Pocknix Control QAM plugin"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL2')
# decky-loader = /usr/bin/decky-loader (native). pocknix-steam ships the proton wrapper +
# /usr/share/pocknix/fex-profiles.json the plugin's FEX tab drives (soft coupling: the plugin
# carries a fallback copy of the profile contract, so no hard dep).
depends=('decky-loader')
source=('pocknix-decky-sync' 'pocknix-decky-sync.service' 'pocknix-decky-loader.service')
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 "${srcdir}/pocknix-decky-sync"      "${pkgdir}/usr/lib/pocknix/pocknix-decky-sync"
  install -Dm644 "${srcdir}/pocknix-decky-sync.service"   "${pkgdir}/usr/lib/systemd/system/pocknix-decky-sync.service"
  install -Dm644 "${srcdir}/pocknix-decky-loader.service" "${pkgdir}/usr/lib/systemd/system/pocknix-decky-loader.service"

  # Pocknix Control plugin — runtime payload only (frontend build sources/tooling stay out).
  local plug="${startdir}/pocknix-control" dest="${pkgdir}/usr/share/decky-plugins/PocknixControl"
  install -d -m755 "${dest}"
  cp -a "${plug}/plugin.json" "${plug}/package.json" "${plug}/main.py" "${plug}/fex-profiles.json" "${dest}/"
  cp -a "${plug}/py_modules" "${plug}/dist" "${dest}/"
  rm -f "${dest}/dist"/*.map
  find "${dest}" -name __pycache__ -type d -prune -exec rm -rf {} +
}
