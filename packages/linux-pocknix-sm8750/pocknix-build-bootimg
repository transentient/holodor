#!/bin/bash
# pocknix-build-bootimg — (re)assemble the qcom-abl /flash/KERNEL from the installed kernel.
#
# Run by the linux-pocknix alpm hook after a kernel install/upgrade (and runnable by hand). Mirrors
# scripts/build-kernel.sh's assemble_bootimg: gzip(/boot/Image) with the board dtbs appended
# (DTB_GLOBS, same set as the kernel package ships to /boot/dtbs — the ROCKNIX ABL picks the dtb by
# the model string it stores in devinfo, scanning the appended-dtb region, so only the boards this
# image serves need to be there; up to kernel -26 all 392 dtbs were appended = 41 MB more to read),
# a GPU-firmware ramdisk, then mkbootimg (header v0, offsets 0) with the baked cmdline
# -> /flash/KERNEL. Keeps a /flash/KERNEL.bak and writes /flash/KERNEL.md5 (the ABL verifies
# KERNEL against its md5).
set -euo pipefail

FLASH="${FLASH:-/flash}"
MKBOOTIMG=/usr/lib/pocknix/mkbootimg/mkbootimg.py
CMDLINE_FILE=/usr/lib/pocknix/kernel-cmdline
# Board dtbs to append (globs under /boot/dtbs). Keep in sync with _dtb_globs in the PKGBUILD and
# BOOTIMG_DTB_GLOBS in scripts/build-kernel.sh. Falls back to every /boot/dtbs/*.dtb if nothing
# matches (an older kernel package still installed), so this can never write a dtb-less KERNEL.
DTB_GLOBS="${POCKNIX_BOOTIMG_DTB_GLOBS:-cq8725s-*.dtb}"

[ -f /boot/Image ] || { echo "pocknix-build-bootimg: no /boot/Image — nothing to do"; exit 0; }
[ -f "$MKBOOTIMG" ] && [ -f "$CMDLINE_FILE" ] || { echo "pocknix-build-bootimg: mkbootimg/cmdline missing"; exit 0; }
# In the image-build chroot /flash isn't a real mount; build-sd-image.sh/install.sh assemble KERNEL
# there instead, so skip. On the device /flash is the FAT boot partition (fstab) -> rebuild.
mountpoint -q "$FLASH" || { echo "pocknix-build-bootimg: $FLASH not mounted — skipping (build chroot?)"; exit 0; }

cmdline="$(cat "$CMDLINE_FILE")"
# Pin root= to the partition we are RUNNING from: the static file carries the SD
# image's PARTUUID, which is wrong on an internal install — and with SD + internal
# both present, two partitions share the root partlabel (the dry-run race). This
# makes every on-device rebuild self-healing, whichever medium it runs on.
rootsrc="$(findmnt -nvo SOURCE / 2>/dev/null || true)"
rootuuid="$(blkid -s PARTUUID -o value "$rootsrc" 2>/dev/null || true)"
if [ -n "$rootuuid" ]; then
  cmdline="$(printf '%s' "$cmdline" | sed -E "s@root=PART(LABEL|UUID)=[^ ]*@root=PARTUUID=${rootuuid}@")"
fi
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

gzip -c /boot/Image > "$tmp/kernel.gz"
ndtb=0
for g in $DTB_GLOBS; do
  for d in /boot/dtbs/$g; do [ -f "$d" ] || continue; cat "$d" >> "$tmp/kernel.gz"; ndtb=$((ndtb+1)); done
done
if [ "$ndtb" -eq 0 ]; then
  echo "pocknix-build-bootimg: WARNING: no /boot/dtbs match '$DTB_GLOBS' — appending every dtb instead"
  for d in /boot/dtbs/*.dtb; do [ -f "$d" ] || continue; cat "$d" >> "$tmp/kernel.gz"; ndtb=$((ndtb+1)); done
fi
[ "$ndtb" -gt 0 ] || { echo "pocknix-build-bootimg: no dtb under /boot/dtbs — refusing to write a KERNEL the ABL cannot boot"; exit 1; }
# Boot-critical GPU firmware initramfs: the built-in adreno driver requests its SQE microcode
# BEFORE the SD rootfs mounts — with an empty ramdisk that request ENOENTs, the GPU never
# initializes, and gamescope exits immediately (v0.2 shipped that way; the race is timing luck).
# The kernel serves early request_firmware() from the unpacked initramfs, so pack the gen80000
# set (~130KB) from the installed firmware tree. Keep in sync with kernel/sm8750/config/
# bootimg-firmware.list (scripts/build-kernel.sh embeds the same set at build time).
fwroot="$tmp/fwroot"; mkdir -p "$fwroot/lib/firmware/qcom/sm8750"
cp /usr/lib/firmware/qcom/gen80000_* "$fwroot/lib/firmware/qcom/" 2>/dev/null || true
cp /usr/lib/firmware/qcom/sm8750/gen80000_zap.mbn "$fwroot/lib/firmware/qcom/sm8750/" 2>/dev/null || true
if ! ls "$fwroot"/lib/firmware/qcom/gen80000_* >/dev/null 2>&1; then
  echo "pocknix-build-bootimg: WARNING: no gen80000 firmware found — KERNEL will boot with a dead GPU"
fi
if command -v cpio >/dev/null 2>&1; then (cd "$fwroot" && find lib | cpio -o -H newc --quiet) | gzip -9 > "$tmp/ramdisk"
elif command -v bsdtar >/dev/null 2>&1; then (cd "$fwroot" && bsdtar --format newc -cf - lib) | gzip -9 > "$tmp/ramdisk"
else printf 'dummy' > "$tmp/ramdisk"; echo "pocknix-build-bootimg: WARNING: no cpio/bsdtar — shipped a dummy ramdisk (GPU race!)"; fi

python3 "$MKBOOTIMG" \
  --kernel "$tmp/kernel.gz" --ramdisk "$tmp/ramdisk" \
  --kernel_offset 0x00000000 --ramdisk_offset 0x00000000 --tags_offset 0x00000000 \
  --os_version 12.0.0 --os_patch_level "$(date '+%Y-%m')" --header_version 0 \
  --cmdline "$cmdline" -o "$tmp/KERNEL"

mount -o remount,rw "$FLASH" 2>/dev/null || true
[ -f "$FLASH/KERNEL" ] && cp -f "$FLASH/KERNEL" "$FLASH/KERNEL.bak"
cp -f "$tmp/KERNEL" "$FLASH/KERNEL"
( cd "$FLASH" && md5sum KERNEL > KERNEL.md5 )
sync
echo "pocknix-build-bootimg: rebuilt $FLASH/KERNEL (kernel $(cat /usr/lib/pocknix/kernelrelease 2>/dev/null || echo '?'), $ndtb dtb(s), $(du -h "$FLASH/KERNEL" | cut -f1); KERNEL.bak kept)"
