-                        ubwc_tile_height_alignment);
+   layout->ubwc_height0 = align(DIV_ROUND_UP(ubwc_height0, ubwc_blockheight),
+                                ubwc_tile_height_alignment);
 
    uint32_t min_3d_layer_size = 0;
 
