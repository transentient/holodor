#!/bin/sh
# SDAM suspend breadcrumb (pre). Ported from ROCKNIX (GPL-2.0).
# Mark SDAM byte 0x50 = 0x01 (entered suspend, kernel PM path not yet completed).
# On the next boot: 0x01 => failure was inside the kernel PM path; 0xFF => suspend/
# resume completed fully. Offset 0x50 is within the 0x50-0x7f scratch window that
# the PM8150 SDAM (dts nvram@b100, patch 0102) accepts (offset 0 is out of bounds).
# bsp-common 34: the nvmem is found by its device-tree node, not by name. nvmem ids
# (spmi_sdam0, spmi_sdam1, ...) come from one counter shared by every nvmem device,
# so the index moves with probe order (it was spmi_sdam1 on kernel 26 and the hook
# wrote nowhere, "SDAM write failed" on every sleep).
. /usr/lib/pocknix/sdam-debug-lib 2>/dev/null || exit 0
dev=$(sdam_nvmem) || exit 0
printf '\x01' | dd of="$dev" bs=1 count=1 seek=80 conv=notrunc 2>/dev/kmsg \
  || echo "003-sdam-debug: SDAM write failed ($dev)" >/dev/kmsg
