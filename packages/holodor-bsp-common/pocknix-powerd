#!/usr/bin/env python3
# pocknix-powerd — power button short-press => suspend (session-agnostic).
#
# WHY a daemon and not logind HandlePowerKey=suspend: on the RP6 the press that WAKES the
# device is delivered to userspace as a normal KEY_POWER after resume — that's how the old
# logind default (poweroff) shut the device down on every wake (see pocknix-bsp
# 20-pocknix-powerkey.conf). logind has no resume holdoff for the power key
# (HoldoffTimeoutSec covers lid events only), so HandlePowerKey=suspend would re-suspend
# the device on every wake press. This daemon drops any KEY_POWER within
# RESUME_IGNORE_SECS of a resume, detected clocklessly: CLOCK_BOOTTIME advances during
# suspend while CLOCK_MONOTONIC does not, so a jump in their delta == "we just resumed".
#
# Behavior split (keep in sync with pocknix-bsp/20-pocknix-powerkey.conf):
#   short press (release <= SHORT_PRESS_SECS) -> systemctl suspend   (this daemon)
#   long press  (>= LONG_PRESS_SECS)          -> poweroff            (this daemon, PMIC-verified)
#   press while asleep                        -> wake                (PMIC wakeup; kernel)
# Presses between SHORT_PRESS_SECS and LONG_PRESS_SECS do nothing — that dead zone is what
# keeps an accidental lingering press from sleeping AND from shutting down.
#
# WHY the long press moved here from logind (2026-10-11): on the RP5, docked and idle, the
# device suspended, woke 20 s later and logind logged "Power key pressed short" then "Power
# key pressed long" and powered the device off — nobody was in the room. The PMIC key
# driver (pm8941-pwrkey) reports the key from a status-register read in its interrupt; a
# glitch that reads "down" with no release interrupt leaves KEY_POWER held forever, and
# logind only counts seconds. Here a long press is honoured only if the PMIC's real-time
# status register (PON_RT_STS, KPDPWR_N_SET) still shows the key physically down at the
# 5 s mark; otherwise it is logged as a phantom and ignored. logind's
# HandlePowerKeyLongPress is 'ignore' (20-pocknix-powerkey.conf) so the two never race.
#
# Plasma Mobile note: the shell also reacts to KEY_POWER (display toggle/lock). That's fine
# alongside this daemon — suspend wins, and the wake press (debounced here) is what the
# shell uses to light the panel back up. powerdevil is NOT configured to suspend, so there
# is exactly one suspend requester in every session.
#
# Robustness rules inherited from pocknix-volumed: match devices by CAPABILITY (never by
# name), never exit, drop erroring fds immediately and rescan, bound every subprocess.
import os, re, sys, time, select, subprocess
try:
    from evdev import InputDevice, list_devices, ecodes
except ImportError:
    sys.exit("pocknix-powerd: python-evdev not installed")

SHORT_PRESS_SECS   = 0.8   # release within this = "a press" -> suspend
LONG_PRESS_SECS    = 5.0   # held this long AND physically down at the PMIC -> poweroff
PON_RT_STS_OFF     = 0x10  # PON real-time status register, offset from the PON base
RESUME_IGNORE_SECS = 3.0   # swallow KEY_POWER this long after any resume
RESCAN_SECS        = 5     # re-enumerate devices that (dis)appeared
SUSPEND_TIMEOUT    = 5     # never let a stuck systemctl block the loop
BACKLIGHT_GLOB     = "/sys/class/backlight/*/bl_power"
BRIGHTNESS_GLOB    = "/sys/class/backlight/*/brightness"

# Idle-dim vs dead-looking screen (soak finding #1, 2026-08-31): Steam idle-dims to ~3%
# of max and never DPMS-blanks on this stack; 3% reads as OFF to a human, so users press
# power "to wake the screen" and actually SUSPEND a healthy device — then the wake brings
# the panel back still at 3% ("wake did nothing") and the death spiral is on. Treat
# sub-floor brightness as screen-off: a press RESTORES brightness instead of suspending,
# and every resume raises a sub-floor panel to RESTORE_FRAC so wake is always visible.
# Steam's own dim logic re-dims on idle later; a deliberate user brightness this low is
# assumed not to exist (Steam's slider floor sits above it).
DIM_FLOOR_FRAC     = 0.06  # below this fraction of max_brightness = "looks off"
RESTORE_FRAC       = 0.35  # what a display-wake press / resume restores to
GRACE_UNIT         = "pocknix-wake-grace.service"  # bsp-common wake-grace inhibitor

# Per-event journal chatter (suspend/resume/screen-off lines) is off by default; set
# Environment=POCKNIX_POWERD_DEBUG=1 on the unit to get it back. Device-discovery and
# error lines stay unconditional.
DEBUG = os.environ.get("POCKNIX_POWERD_DEBUG", "0") == "1"

def dbg(msg):
    if DEBUG:
        print(f"pocknix-powerd: {msg}", flush=True)

def boot_mono_delta():
    return time.clock_gettime(time.CLOCK_BOOTTIME) - time.clock_gettime(time.CLOCK_MONOTONIC)

def screen_is_on():
    # bl_power uses FB_BLANK_* (0 = FB_BLANK_UNBLANK = on; 4 = FB_BLANK_POWERDOWN). The panel is
    # "on" iff SOME backlight reports 0 — the RP6 has a real ae94000.dsi.0 node (tracks DPMS) plus
    # a legacy 'backlight' node stuck at 4, so we OR across all and only treat all-non-zero as off.
    # If we can't read any node, assume ON (fail toward the normal press=suspend behavior).
    import glob
    found = False
    for p in glob.glob(BACKLIGHT_GLOB):
        found = True
        try:
            if int(open(p).read().strip()) == 0:
                return True
        except (OSError, ValueError):
            continue
    return not found   # nodes exist and none were 0 -> off; no nodes at all -> assume on

def brightness_state():
    # Returns (cur, max, path) for the first readable backlight with a sane max, else None.
    import glob
    for p in glob.glob(BRIGHTNESS_GLOB):
        try:
            cur = int(open(p).read().strip())
            mx = int(open(os.path.join(os.path.dirname(p), "max_brightness")).read().strip())
            if mx > 0:
                return cur, mx, p
        except (OSError, ValueError):
            continue
    return None

def looks_off():
    st = brightness_state()
    return st is not None and st[0] < st[1] * DIM_FLOOR_FRAC

def restore_brightness(reason):
    st = brightness_state()
    if st is None:
        return
    cur, mx, path = st
    if cur >= mx * DIM_FLOOR_FRAC:
        return
    target = int(mx * RESTORE_FRAC)
    try:
        # close inside the try: sysfs reports the error at flush/close (EINVAL while the
        # panel is off, e.g. a docked wake with the internal display disabled), and an
        # unclosed file raised it as "Exception ignored" at garbage collection instead.
        with open(path, "w") as f:
            f.write(str(target))
        print(f"pocknix-powerd: {reason}: brightness {cur} -> {target} (of {mx})", flush=True)
    except OSError as e:
        print(f"pocknix-powerd: {reason}: brightness restore {cur} -> {target} refused ({e.strerror}); panel off?", flush=True)

def battery_state():
    # (capacity%, on_ac) from sysfs; (None, True) if unreadable so we never block a suspend on a guess.
    import glob
    cap, ac = None, False
    for d in glob.glob("/sys/class/power_supply/*"):
        try:
            t = open(os.path.join(d, "type")).read().strip()
            if t == "Battery":
                cap = int(open(os.path.join(d, "capacity")).read().strip())
            elif open(os.path.join(d, "online")).read().strip() == "1":
                ac = True
        except (OSError, ValueError):
            continue
    return cap, (ac if cap is not None else True)

MIN_SUSPEND_PCT = 5   # below this on battery, suspend = brownout death (09-02 00:51); power off instead

def do_suspend():
    dbg("short press -> suspending")
    cap, ac = battery_state()
    if cap is not None and cap < MIN_SUSPEND_PCT and not ac:
        print(f"pocknix-powerd: battery {cap}% < {MIN_SUSPEND_PCT}% and unplugged -> poweroff instead of suspend", flush=True)
        try:
            subprocess.run(["systemctl", "poweroff"], timeout=SUSPEND_TIMEOUT,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except (subprocess.TimeoutExpired, OSError):
            pass
        return
    # A deliberate press inside the wake-grace window must WIN, not be silently
    # refused by the grace's block inhibitor ("pulses but does nothing", 08-31).
    try:
        subprocess.run(["systemctl", "stop", GRACE_UNIT], timeout=SUSPEND_TIMEOUT,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (subprocess.TimeoutExpired, OSError):
        pass
    try:
        r = subprocess.run(["systemctl", "suspend"], timeout=SUSPEND_TIMEOUT,
                           stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        if r.returncode != 0:
            # A block inhibitor (install, clone, download-inhibit) makes this refusal SILENT
            # to the user ("pulses but nothing happens") — at least make it loud in the journal.
            print(f"pocknix-powerd: systemctl suspend refused (rc={r.returncode}): {r.stderr.strip()}", flush=True)
    except (subprocess.TimeoutExpired, OSError) as e:
        print(f"pocknix-powerd: systemctl suspend failed: {e}", flush=True)

def do_poweroff(reason):
    print(f"pocknix-powerd: {reason} -> poweroff", flush=True)
    try:
        subprocess.run(["systemctl", "poweroff"], timeout=SUSPEND_TIMEOUT,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (subprocess.TimeoutExpired, OSError) as e:
        print(f"pocknix-powerd: systemctl poweroff failed: {e}", flush=True)

def pmic_key_down(dev):
    """Ground truth for "is the power button physically down right now".

    The PMIC power key (pm8941-pwrkey) sits under .../c440000.spmi:pmic@<sid>:pon@<base>:pwrkey;
    its PON real-time status register is readable through regmap debugfs
    (/sys/kernel/debug/regmap/0-<sid>/registers, one fixed-width "addr: val" line per
    register, so the register is reached by seeking). Returns True/False, or None when this
    is not a PMIC key or the register cannot be read (the kernel's event is trusted then).
    """
    try:
        sysdev = os.path.realpath(f"/sys/class/input/{os.path.basename(dev.path)}/device/device")
    except OSError:
        return None
    m = re.search(r'pmic@([0-9a-fA-F]+):pon@([0-9a-fA-F]+):pwrkey$', sysdev)
    if not m:
        return None
    sid, base = int(m.group(1), 16), int(m.group(2), 16)
    try:
        compat = open(os.path.join(sysdev, "of_node", "compatible"), "rb").read()
    except OSError:
        compat = b""
    bit = 0x80 if b"pmk8350" in compat else 0x01   # PON_GEN3_KPDPWR_N_SET / PON_KPDPWR_N_SET
    reg = base + PON_RT_STS_OFF
    try:
        with open(f"/sys/kernel/debug/regmap/0-{sid:02x}/registers", "rb") as f:
            width = len(f.readline())              # "%0Nx: %02x\n", N = map address width
            if width < 6:
                return None
            f.seek(width * reg)
            line = f.read(width).decode(errors="replace")
    except OSError:
        return None
    addr, _, val = line.strip().partition(": ")
    try:
        if int(addr, 16) != reg:
            return None
        return bool(int(val, 16) & bit)
    except ValueError:
        return None

def has_power_key(dev):
    return ecodes.KEY_POWER in dev.capabilities().get(ecodes.EV_KEY, [])

def scan(known_paths):
    found = {}
    for path in list_devices():
        if path in known_paths:
            continue
        try:
            dev = InputDevice(path)
        except OSError:
            continue
        if has_power_key(dev):
            print(f"pocknix-powerd: watching {path} ({dev.name})", flush=True)
            found[path] = dev
        else:
            dev.close()
    return found

devs = {}                 # path -> InputDevice
down_at = {}              # path -> monotonic time of KEY_POWER down
stuck = set()             # paths whose kernel key state says "down" while the PMIC says released
last_scan = 0.0
last_delta = boot_mono_delta()
ignore_until = 0.0        # monotonic deadline; drop KEY_POWER until then

while True:
    now = time.monotonic()
    if now - last_scan >= RESCAN_SECS:
        devs.update(scan(set(devs)))
        last_scan = now
        # A phantom "down" with no release leaves the kernel's key state held: the next real
        # press then produces no down event at all (the input core drops same-value reports).
        # Poll the kernel state and ask the PMIC: really held -> time it; released -> stuck.
        for path, dev in list(devs.items()):
            if path in down_at:
                continue
            try:
                held = ecodes.KEY_POWER in dev.active_keys()
            except OSError:
                continue
            if not held:
                stuck.discard(path)
                continue
            phys = pmic_key_down(dev)
            if phys:
                print(f"pocknix-powerd: kernel reports KEY_POWER held on {path} with no event seen;"
                      f" PMIC agrees -> timing a long press", flush=True)
                down_at[path] = now
            elif phys is False and path not in stuck:
                print(f"pocknix-powerd: kernel reports KEY_POWER held on {path} but the PMIC says"
                      f" released -> stuck phantom state; the next release counts as a short press", flush=True)
                stuck.add(path)
    if not devs:
        time.sleep(1)              # nothing to watch yet — wait, never exit
        continue

    by_fd = {dev.fd: (path, dev) for path, dev in devs.items()}
    timeout = RESCAN_SECS
    if down_at:
        timeout = max(0.05, min(timeout, min(down_at.values()) + LONG_PRESS_SECS - time.monotonic()))
    try:
        ready, _, _ = select.select(list(by_fd), [], [], timeout)
    except OSError:
        for dev in devs.values():
            try: dev.close()
            except OSError: pass
        devs.clear(); down_at.clear()
        last_scan = 0.0
        continue

    # Resume detection BEFORE processing events: the wake press arrives in the same loop
    # pass that follows the resume, so the debounce must be armed first.
    now = time.monotonic()
    delta = boot_mono_delta()
    if delta - last_delta > 0.5:
        ignore_until = now + RESUME_IGNORE_SECS
        down_at.clear()            # a pre-suspend down must not pair with a post-resume up
        dbg(f"resume detected — ignoring power key for {RESUME_IGNORE_SECS}s")
        # Waking to a sub-floor (idle-dimmed) panel looks identical to a failed wake and
        # feeds the press spiral — make every wake visibly a wake.
        restore_brightness("resume with dim panel")
    last_delta = delta

    for fd in ready:
        path, dev = by_fd[fd]
        try:
            for ev in dev.read():
                if ev.type != ecodes.EV_KEY or ev.code != ecodes.KEY_POWER:
                    continue
                if ev.value in (0, 1):             # rare; journal it with its source device
                    print(f"pocknix-powerd: KEY_POWER {'down' if ev.value else 'up'} on {path} ({dev.name})"
                          f"{' (resume holdoff, ignored)' if now < ignore_until else ''}", flush=True)
                if now < ignore_until:
                    continue                       # wake press — swallow it
                if ev.value == 1:                  # down: start timing
                    down_at[path] = now
                elif ev.value == 0:                # up: short press => suspend
                    t0 = down_at.pop(path, None)
                    if t0 is None and path in stuck:
                        # the press that cleared a stuck state has no down event; honour it
                        print(f"pocknix-powerd: release on {path} cleared the stuck key state -> short press", flush=True)
                        t0 = now
                    stuck.discard(path)
                    if t0 is not None and now - t0 <= SHORT_PRESS_SECS:
                        # If the screen is already blanked (Plasma/gamescope idle timeout turned
                        # DPMS off but the system is still awake), this press is "wake the display",
                        # NOT "sleep". We don't grab the key, so the compositor gets it too and
                        # un-blanks on the input event; we just decline to suspend. First press
                        # wakes the screen, a later press (screen on) then suspends as normal.
                        if not screen_is_on():
                            dbg("screen off (idle-blank) -> wake only, not suspending")
                            continue
                        # Same intent when the panel is idle-dimmed below the visibility floor
                        # (this stack dims, never blanks — bl_power stays 0): the user is trying
                        # to get the screen back, so give them that, actively.
                        if looks_off():
                            restore_brightness("press on dim panel -> display wake")
                            continue
                        # guard the freeze window too: events queued across our own
                        # suspend get dropped even before the delta jump is seen
                        ignore_until = now + RESUME_IGNORE_SECS
                        do_suspend()
        except OSError:
            try: dev.close()
            except OSError: pass
            devs.pop(path, None); down_at.pop(path, None)
    # long press: a key held LONG_PRESS_SECS powers off — but only if the PMIC agrees that the
    # button is physically down. A "down" with no release interrupt (seen 2026-10-10, docked,
    # nobody near the device) stays down in the kernel forever and would otherwise power off
    # every time.
    for path, t0 in list(down_at.items()):
        held = now - t0
        if held < LONG_PRESS_SECS:
            continue
        down_at.pop(path, None)
        dev = devs.get(path)
        phys = pmic_key_down(dev) if dev is not None else None
        if phys is False:
            print(f"pocknix-powerd: KEY_POWER on {path} held {held:.1f}s but the PMIC says released"
                  f" -> phantom press, ignored", flush=True)
            continue
        do_poweroff(f"long press {held:.1f}s on {path} (pmic={'down' if phys else 'unverified'})")
