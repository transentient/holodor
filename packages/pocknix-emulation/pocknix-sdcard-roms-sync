    "pcsx2": "ps2",
    "aethersx2": "ps2",
    "nethersx2": "ps2",
    "armsx2": "ps2",
    "playstation2": "ps2",
    "rpcs3": "ps3",
    "playstation3": "ps3",
    "ppsspp": "psp",
