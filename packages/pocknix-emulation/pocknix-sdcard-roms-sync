#!/usr/bin/python3
# pocknix-sdcard-roms-sync — Plug-and-play Android / portable microSD ROM, BIOS & ES-DE discovery.
#
# Called by:
#   - /usr/lib/hwsupport/sdcard-mount.sh (on microSD insert/remove under /run/media/deck/<label>)
#   - /usr/bin/pocknix-roms-init         (at login, in case the SD card mounted earlier in boot)
#   - /usr/bin/pocknix-steam-sync        (before syncing ES-DE favorites into Steam shortcuts.vdf)
#
# Design:
#   1. Non-destructive union via symlinks:
#      Game files/folders on the SD card are symlinked into the user's active ES-DE ROM directory
#      (default ~/Emulation/ROMs/<system>) and ~/Emulation/BIOS. Local files on internal storage
#      are NEVER overwritten, so internal and SD-card libraries coexist seamlessly.
#   2. Case-insensitive Android frontend compatibility:
#      Supports ES-DE, EmuDeck, Daijisho, Beacon, and RetroArch folder layouts (ROMs/, Roms/,
#      roms/, Emulation/roms/, etc.) and maps common Android system aliases (ngc/gamecube -> gc,
#      ps1/playstation -> psx, nethersx2/aethersx2 -> ps2, nsw/yuzu/eden -> switch, 3ds -> n3ds,
#      dc -> dreamcast, md -> genesis, sfc -> snes, fc -> nes, pce -> tg16, etc.).
#   3. Automatic PS2 BIOS alias (ps2-bios.bin):
#      ARMSX2 expects ~/Emulation/BIOS/ps2-bios.bin, whereas Android (NetherSX2/AetherSX2) users
#      typically keep raw scph*.bin dumps. If ps2-bios.bin is missing and a valid 4 MB PS2 BIOS
#      dump is found in ~/Emulation/BIOS, it is linked as ps2-bios.bin automatically.
#   4. Clean hot-unplug:
#      On card removal (or at the start of every scan), any symlink in ~/Emulation or ~/ES-DE
#      whose target points into /run/media/deck/ and no longer resolves is pruned cleanly.
import os
import re
import sys

HOME = os.path.expanduser("~")
EMU = os.path.join(HOME, "Emulation")
BIOS_DIR = os.path.join(EMU, "BIOS")
ESDE_DIR = os.path.join(HOME, "ES-DE")
MEDIA_ROOT = "/run/media/deck"

CANONICAL_SYSTEMS = {
    "nes", "famicom", "snes", "sfc", "n64", "gb", "gbc", "gba", "nds", "n3ds",
    "genesis", "megadrive", "mastersystem", "gamegear", "segacd", "sega32x", "saturn", "dreamcast",
    "tg16", "pcengine", "supergrafx", "neogeo", "arcade", "fbneo", "mame",
    "atari2600", "atari7800", "atarilynx", "atarijaguar",
    "wonderswan", "wonderswancolor", "ngp", "ngpc", "virtualboy",
    "psx", "ps2", "ps3", "psp", "psvita",
    "gc", "wii", "wiiu", "switch", "xbox",
}

SYSTEM_ALIASES = {
    "ngc": "gc",
    "gamecube": "gc",
    "nintendogamecube": "gc",
    "wii-u": "wiiu",
    "nsw": "switch",
    "yuzu": "switch",
