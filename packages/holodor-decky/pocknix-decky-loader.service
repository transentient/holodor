[Unit]
Description=Decky Loader
# /usr/bin/decky-loader is the decky-loader package: upstream's backend on the native python.
# It injects into a RUNNING Steam client over CEF devtools (localhost:8080) and polls until
# one exists; the plugin store is fetched lazily, so it does not wait for the network.
After=pocknix-decky-sync.service
Wants=pocknix-decky-sync.service

[Service]
Type=simple
User=root
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=15
# Package-owned scratch cwd, not ~/homebrew/services: the loader's self-updater is patched
# out, and nothing else writes to getcwd(), but a stray write can never land in deck's tree.
StateDirectory=decky-loader
WorkingDirectory=/var/lib/decky-loader
# Start after Steam is up (60 s cap) and below it in priority so boot-time CPU goes to
# gamescope/Steam first; native python imports are cheap, the nice is for the plugin backends.
ExecStartPre=/bin/sh -c 'for i in $(seq 60); do pidof steam >/dev/null 2>&1 && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/bin/decky-loader
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
Environment=UNPRIVILEGED_PATH=/home/deck/homebrew
Environment=PRIVILEGED_PATH=/home/deck/homebrew
Environment=PLUGIN_PATH=/home/deck/homebrew/plugins
Environment=UNPRIVILEGED_USER=deck
Environment=USE_CEF_CLOSE_WORKAROUND=0
Environment=LOG_LEVEL=INFO

[Install]
WantedBy=multi-user.target
